# ---------- GUI: Copia de seguridad ----------
gui.backup.folders = Carpeta de copia de seguridad
gui.backup.serverPath = Carpeta en el SQL Server (ruta del servidor)
gui.backup.serverPathHint = SQL Server escribe aquí la copia de seguridad, vista desde el equipo de SQL Server (p. ej. D:\\SqlBackups).
gui.backup.useServerDefault = Predeterminada del servidor
gui.backup.accessPath = La misma carpeta vista desde este programa (ruta de acceso)
gui.backup.accessPathHint = Déjelo vacío para un servidor local. Para un servidor remoto, introduzca la ruta del recurso compartido (p. ej. \\\\SRV01\\SqlBackups). Necesaria para ZIP y retención.
gui.backup.checkAccess = Comprobar acceso
gui.backup.noFolder = Introduzca primero una carpeta.
gui.backup.accessOk = Este programa puede leer, escribir y eliminar en {path}.
gui.backup.accessFailed = Sin acceso a {path}: {error}
gui.backup.pathsInfo = El archivo de copia de seguridad lo escribe la cuenta de servicio de SQL Server (p. ej. NT Service\\MSSQL$SQLEXPRESS), no este programa. Elija una carpeta a la que puedan acceder tanto la cuenta de servicio como la cuenta que ejecuta el trabajo, p. ej. D:\\SqlBackups (la carpeta predeterminada en Program Files suele denegar el acceso a otras cuentas).
gui.backup.fileName = Nombre de archivo
gui.backup.template = Plantilla de nombre de archivo
gui.backup.templateHint = {db} es obligatorio. También: {server}, {job} y partes de fecha como {yyyyMMdd}, {HHmmss}, {yyyy-MM-dd}. Se agrega .bak si falta.
gui.backup.preview = Ejemplo:
gui.backup.options = Opciones
gui.backup.compression = Compresión
gui.backup.checksum = Suma de comprobación
gui.backup.copyOnly = Copia de seguridad de solo copia
gui.backup.copyOnlyHint = Las copias de seguridad de solo copia no afectan a la cadena de copias de otras herramientas de copia de seguridad.
gui.backup.verify = Verificar después de la copia (RESTORE VERIFYONLY)
gui.backup.commandTimeout = Tiempo de espera de comandos (minutos)
gui.backup.commandTimeoutHint = 0 = ilimitado.
gui.backup.compressionUnsupported = El servidor conectado no admite compresión (Express/Web); se desactivará al ejecutar.

