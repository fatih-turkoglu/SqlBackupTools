cli.test.compressionNo = nicht unterstützt
cli.test.defaultBackupDir = Standard-Sicherungsordner
cli.test.access = Zugriff auf Sicherungsordner
cli.test.accessOK = OK ({path})
cli.test.accessFailed = FEHLER
cli.test.success = Verbindung erfolgreich.
cli.list.header = DATENBANK\tZUSTAND\tWIEDERHERSTELLUNG\tGRÖSSE (MB)\tSYSTEM\tLETZTE VOLLSICHERUNG\tSICHERUNG
cli.list.failed = FEHLER: {reason}
cli.list.skipped = nein ({reason})
cli.list.footer = {count} Datenbank(en), {backup} werden gesichert

