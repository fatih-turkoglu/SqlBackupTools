gui.backup.fileName = Nome file
gui.backup.template = Modello del nome file
gui.backup.templateHint = {db} è obbligatorio. Inoltre: {server}, {job} e parti di data come {yyyyMMdd}, {HHmmss}, {yyyy-MM-dd}. Se manca, viene aggiunto .bak.
gui.backup.preview = Esempio:
gui.backup.options = Opzioni
gui.backup.compression = Compressione
gui.backup.checksum = Checksum
gui.backup.copyOnly = Backup di sola copia
gui.backup.copyOnlyHint = I backup di sola copia non influiscono sulla catena di backup di altri strumenti di backup.
gui.backup.verify = Verifica dopo il backup (RESTORE VERIFYONLY)
gui.backup.commandTimeout = Timeout dei comandi (minuti)
gui.backup.commandTimeoutHint = 0 = illimitato.
gui.backup.compressionUnsupported = Il server connesso non supporta la compressione (Express/Web); verrà disattivata durante l'esecuzione.

