# SqlBackup-Sprachdatei – Deutsch
# Format: Schlüssel = Wert  (UTF-8). Zeilen, die mit "#" beginnen, sind Kommentare.
# Platzhalter wie {name} werden zur Laufzeit ersetzt; beim Übersetzen unverändert lassen.
# Escapes: \n neue Zeile, \t Tabulator, \\ Backslash.
@code = de
@name = Deutsch

# ---------- Allgemein ----------
common.unknown = unbekannt
common.taskDescription = Führt den SqlBackup-Auftrag "{job}" aus (von SqlBackup erstellt).
common.batchFiles = Batchdateien

# ---------- Auftragseinstellungen (config) ----------
err.config.nameInvalid = der Auftragsname muss 1-64 Zeichen lang sein und darf nur Buchstaben, Ziffern, '_', '-' und '.' enthalten
err.config.nameDots = der Auftragsname darf nicht nur aus Punkten bestehen
err.config.serverEmpty = der Servername darf nicht leer sein
err.config.portRange = der Port muss zwischen 0 und 65535 liegen
err.config.portTCPOnly = ein Port kann nur mit dem TCP-Protokoll verwendet werden
err.config.protocolInvalid = ungültiges Protokoll: "{value}"
err.config.userEmpty = für die SQL-Authentifizierung ist ein Benutzername erforderlich
err.config.passwordEmpty = für die SQL-Authentifizierung ist ein Kennwort erforderlich
err.config.authInvalid = ungültiger Authentifizierungstyp: "{value}"
err.config.timeoutNegative = das Verbindungs-Timeout darf nicht negativ sein
err.config.noDatabase = es muss mindestens eine Datenbank ausgewählt werden
err.config.serverPathEmpty = der Sicherungsordner (Serverpfad) darf nicht leer sein
err.config.commandTimeoutNegative = das Befehls-Timeout darf nicht negativ sein
err.config.deleteBakNeedsZip = zum Löschen der .bak-Dateien nach dem ZIP muss die ZIP-Option aktiviert sein
err.config.retentionValue = der Aufbewahrungswert muss größer als 0 sein
err.config.retentionModeInvalid = ungültiger Aufbewahrungsmodus: "{value}"
err.config.scheduleTime = die Uhrzeit des Zeitplans muss im Format HH:MM angegeben werden (z. B. 02:00)
err.config.scheduleNoDays = für einen wöchentlichen Zeitplan muss mindestens ein Tag ausgewählt werden
err.config.scheduleDayInvalid = ungültiger Tag: "{value}"
err.config.scheduleInterval = das Intervall des stündlichen Zeitplans muss 1-23 Stunden betragen
err.config.scheduleFrequencyInvalid = ungültige Häufigkeit des Zeitplans: "{value}"
err.config.runAsInvalid = ungültiges Ausführungskonto: "{value}"
err.config.templateEmpty = die Dateinamenvorlage darf nicht leer sein
err.config.templateNoDb = die Dateinamenvorlage muss {db} enthalten
err.config.templateInvalidChars = die Dateinamenvorlage darf \\ / : * ? " < > | nicht enthalten
err.config.mkdir = Ordner {path} konnte nicht erstellt werden: {err}
err.config.dirPermission = Berechtigungen für den Ordner {path} konnten nicht gesetzt werden: {err}
err.config.jobRead = Auftragsdatei konnte nicht gelesen werden: {err}
err.config.jobParse = Auftragsdatei konnte nicht verarbeitet werden ({path}): {err}
err.config.jobVersion = die Auftragsdatei stammt von einer neueren Version (v{version}); bitte aktualisieren Sie das Programm
err.config.settingsRead = Einstellungsdatei konnte nicht gelesen werden: {err}
err.config.settingsParse = Einstellungsdatei konnte nicht verarbeitet werden ({path}): {err}
err.config.encrypt = Kennwort konnte nicht verschlüsselt werden: {err}
err.config.decryptBase64 = der verschlüsselte Wert ist ungültig (kein Base64)
err.config.decrypt = Kennwort konnte nicht entschlüsselt werden (wurde es auf einem anderen Computer erstellt?): {err}

# ---------- SQL Server (mssql) ----------
err.mssql.connect = Verbindung zum Server fehlgeschlagen: {err}
err.mssql.login = SQL Server hat die Anmeldung abgelehnt: {err}. Prüfen Sie Benutzername und Kennwort (für die SQL-Authentifizierung muss auf dem Server außerdem der Modus "SQL Server- und Windows-Authentifizierung" aktiv sein). Bei Windows-Authentifizierung benötigt das Konto, das den Auftrag ausführt (bei geplanten Aufgaben SYSTEM), eine Anmeldung auf dem Server.
err.mssql.connInvalid = ungültige Verbindungseinstellungen: {err}
err.mssql.serverInfo = Serverinformationen konnten nicht gelesen werden: {err}
err.mssql.listDatabases = Datenbanken konnten nicht aufgelistet werden: {err}
err.mssql.backup = {db} konnte nicht gesichert werden: {err}
err.mssql.backupHint = {db} konnte nicht gesichert werden: {err} — Hinweis: {hint}
err.mssql.hintAccess = Das SQL Server-Dienstkonto (normalerweise {account}) kann nicht in diesen Ordner schreiben; erteilen Sie diesem Konto die Berechtigung "Ändern" für den Ordner oder wählen Sie einen Ordner, in den es schreiben kann.
err.mssql.hintPath = Der Ordner wurde auf dem Computer, auf dem SQL Server läuft, nicht gefunden. Der Sicherungsordner wird vom Server aufgelöst (bei einem Remoteserver ist es kein Pfad auf diesem Computer); erstellen Sie den Ordner oder verwenden Sie einen Pfad oder eine UNC-Freigabe, die der Server erreichen kann.
err.mssql.hintDiskFull = Auf dem Zieldatenträger ist nicht genügend freier Speicherplatz vorhanden; geben Sie Speicherplatz frei oder überprüfen Sie die Aufbewahrungseinstellungen.
err.mssql.verify = Sicherung konnte nicht überprüft werden ({file}): {err}
err.mssql.backupSet = Sicherungsinformationen konnten nicht gelesen werden ({db}): {err}
err.mssql.canceled = Vorgang abgebrochen oder Zeitüberschreitung: {err}
warn.mssql.insecureLogin = das SQL Server-Kennwort wird an den Remoteserver gesendet, ohne dessen Zertifikat zu überprüfen; jemand im Netzwerk könnte es abfangen. Aktivieren Sie die Verschlüsselung mit Zertifikatsprüfung ("Serverzertifikat vertrauen" aus) oder verwenden Sie die Windows-Authentifizierung.

# ---------- Dateinamenvorlage ----------
err.template.unmatchedClose = die Dateinamenvorlage enthält ein '}' ohne Gegenstück
err.template.unclosed = die Dateinamenvorlage enthält ein nicht geschlossenes '{'
err.template.unknown = unbekannter Platzhalter in der Dateinamenvorlage: {{name}}

# ---------- Sicherungsausführung ----------
err.backup.invalidJob = ungültige Auftragseinstellungen: {err}
err.backup.alreadyRunning = der Auftrag "{job}" wird bereits ausgeführt; dieser Lauf wurde nicht gestartet
err.backup.lockHeld = der Auftrag wird bereits ausgeführt
err.backup.lock = Auftragssperre konnte nicht abgerufen werden: {err}
err.backup.password = das gespeicherte Kennwort konnte nicht entschlüsselt werden; wenn die Auftragsdatei von einem anderen Computer kopiert wurde, geben Sie das Kennwort erneut ein: {err}
err.backup.noDatabases = keine Datenbanken zu sichern
err.backup.canceled = Vorgang abgebrochen
err.backup.deleteBak = ZIP erstellt, aber .bak konnte nicht gelöscht werden: {err}
err.backup.access = kein Zugriff auf den Sicherungsordner: {msg}. Der Ordner muss sowohl für das SQL Server-Dienstkonto als auch für das Konto, das dieses Programm ausführt ({account}), lesbar, beschreibbar und löschbar sein (z. B. D:\\SqlBackups); bei einem Remoteserver muss der Zugriffspfad ein UNC-Pfad sein
warn.backup.noCompression = die Server-Edition ({edition}) unterstützt keine Sicherungskomprimierung; Komprimierung deaktiviert

reason.notFound = auf dem Server nicht gefunden
reason.systemExcluded = Systemdatenbanken sind ausgeschlossen
reason.tempdb = tempdb kann nicht gesichert werden
reason.state = die Datenbank befindet sich in keinem Zustand, der eine Sicherung erlaubt ({state})

# ---------- Aufbewahrung ----------
err.retention.readDir = Sicherungsordner konnte nicht gelesen werden: {err}
err.retention.delete = einige alte Sicherungen konnten nicht gelöscht werden: {err}
warn.retention.noDate = Aufbewahrung nicht angewendet, da die Dateinamenvorlage kein Datum (Jahr, Monat und Tag) enthält
warn.retention.canceled = Vorgang abgebrochen; Aufbewahrung nicht angewendet

# ---------- ZIP (archive) ----------
err.archive.dirNotFound = Ordner nicht gefunden: {path}
err.archive.dirNoPermission = keine Berechtigung für den Zugriff auf den Ordner: {path}
err.archive.dirAccess = kein Zugriff auf den Ordner: {err}
err.archive.notDir = der Pfad ist kein Ordner: {path}
err.archive.noWrite = keine Schreibberechtigung für den Ordner ({path}): {err}
err.archive.write = in den Ordner kann nicht geschrieben werden ({path}): {err}
err.archive.noRead = keine Leseberechtigung für den Ordner ({path}): {err}
err.archive.noDelete = keine Löschberechtigung für den Ordner ({path}): {err}
err.archive.noFiles = keine Dateien zum Zippen
err.archive.readBak = Sicherungsdatei konnte nicht gelesen werden: {err}
err.archive.duplicateName = ein ZIP kann nicht zwei Dateien mit demselben Namen enthalten: {name}
err.archive.rename = ZIP-Datei konnte nicht umbenannt werden: {err}
err.archive.create = ZIP-Datei konnte nicht erstellt werden: {err}
err.archive.writeZip = ZIP-Datei konnte nicht geschrieben werden: {err}
err.archive.entry = ZIP-Eintrag konnte nicht erstellt werden: {err}
err.archive.canceled = ZIP abgebrochen: {err}
err.archive.compress = {name} konnte nicht gezippt werden: {err}
err.archive.verify = ZIP-Überprüfung fehlgeschlagen: {err}
err.archive.verifyEntry = ZIP-Überprüfung fehlgeschlagen ({name}): {err}
err.archive.verifyCount = ZIP-Überprüfung fehlgeschlagen: {want} Einträge erwartet, {got} gefunden
err.archive.verifyUnexpected = ZIP-Überprüfung fehlgeschlagen: unerwarteter Eintrag {name}
err.archive.verifySize = ZIP-Überprüfung fehlgeschlagen: Größenabweichung bei {name} ({got} / {want})
err.archive.verifyReadSize = ZIP-Überprüfung fehlgeschlagen: Abweichung der gelesenen Größe bei {name}

# ---------- Protokollierung ----------
err.logging.mkdir = Protokollordner konnte nicht erstellt werden: {err}
err.logging.open = Protokolldatei konnte nicht geöffnet werden: {err}
err.logging.runsMkdir = Ordner für Laufprotokolle konnte nicht erstellt werden: {err}
err.logging.runWrite = Laufprotokoll konnte nicht geschrieben werden: {err}
err.logging.runRead = Laufprotokoll konnte nicht gelesen werden: {err}
err.logging.runParse = Laufprotokoll konnte nicht verarbeitet werden ({path}): {err}
err.logging.cleanup = einige alte Protokolldateien konnten nicht gelöscht werden: {err}

# ---------- Batchdatei und geplante Aufgabe (scheduler) ----------
err.scheduler.exePath = der Programmpfad konnte nicht ermittelt werden: {err}
err.scheduler.path = ungültiger Pfad {path}: {err}
err.scheduler.badPath = der Pfad kann nicht in einer Befehlszeile verwendet werden: "{path}"
err.scheduler.percentPath = der Pfad enthält "%"-Zeichen, die die Aufgabenplanung als Umgebungsvariablen erweitert: {path}
err.scheduler.batchWrite = Batchdatei {path} konnte nicht geschrieben werden: {err}
err.scheduler.noUser = das Benutzerkonto für die Aufgabe konnte nicht ermittelt werden
err.scheduler.accessDenied = die Aufgabenplanung hat den Zugriff verweigert (Administratorrechte erforderlich)
err.scheduler.notFound = geplante Aufgabe nicht gefunden
err.scheduler.connect = Verbindung zur Aufgabenplanung fehlgeschlagen: {err}
err.scheduler.create = die geplante Aufgabe konnte nicht erstellt werden: {err}
err.scheduler.delete = die geplante Aufgabe konnte nicht gelöscht werden: {err}
err.scheduler.run = die geplante Aufgabe konnte nicht gestartet werden: {err}
err.scheduler.query = die geplante Aufgabe konnte nicht gelesen werden: {err}
err.scheduler.elevate = Start mit Administratorrechten fehlgeschlagen: {err}
err.scheduler.elevateCancelled = Administratorrechte wurden nicht erteilt (UAC-Abfrage abgebrochen)
err.scheduler.exeCheck = die Berechtigungen von {path} konnten nicht geprüft werden: {err}
err.scheduler.unsafeExe = eine SYSTEM-Aufgabe kann {exe} nicht ausführen: {account} kann {path} ändern und so eigenen Code als SYSTEM ausführen. Installieren Sie das Programm mit dem Installationsprogramm (Program Files) oder verwenden Sie einen Ordner, in den nur Administratoren schreiben können.
warn.scheduler.systemWindowsAuth = die Aufgabe wird als SYSTEM mit Windows-Authentifizierung ausgeführt: SQL Server benötigt eine Anmeldung für NT AUTHORITY\\SYSTEM (bei einem Remoteserver DOMÄNE\\COMPUTER$) mit Sicherungsberechtigung
warn.scheduler.systemNetworkPath = die Aufgabe wird als SYSTEM ausgeführt: auf den Netzwerkordner {path} wird mit dem Computerkonto (DOMÄNE\\COMPUTER$) zugegriffen, das Lese-, Schreib- und Löschberechtigung benötigt
warn.scheduler.currentUser = die Aufgabe wird nur ausgeführt, solange {user} angemeldet ist

# ---------- Backend der Benutzeroberfläche (app) ----------
err.app.jobNotFound = Auftrag nicht gefunden: {job}
err.app.jobExists = ein Auftrag namens "{job}" ist bereits vorhanden
err.app.alreadyRunning = der Auftrag "{job}" wird bereits ausgeführt
err.app.renameRunning = der Auftrag "{job}" wird ausgeführt; er kann jetzt nicht umbenannt werden
err.app.deleteRunning = der Auftrag "{job}" wird ausgeführt; er kann jetzt nicht gelöscht werden
err.app.elevatedExit = der mit Administratorrechten ausgeführte Befehl ist fehlgeschlagen (Exitcode {code})
err.app.pathOutside = die Datei befindet sich nicht im Protokollordner: {path}
err.app.keepDays = die Protokollaufbewahrung darf nicht negativ sein
err.app.theme = unbekanntes Design: {theme}
warn.app.renamedTask = die geplante Aufgabe des alten Namens ({path}) führt weiterhin den alten Auftrag aus und wird fehlschlagen; löschen Sie sie und erstellen Sie die Aufgabe neu
warn.app.renamedBatch = die Batchdatei des alten Namens ({path}) führt weiterhin den alten Auftrag aus
warn.app.taskOutdated = die geplante Aufgabe ({path}) entspricht nicht den gespeicherten Einstellungen; aktualisieren Sie die Aufgabe

# ---------- Protokollmeldungen ----------
log.job.started = Auftrag gestartet
log.job.done = Auftrag beendet
log.job.failed = Auftrag konnte nicht ausgeführt werden
log.job.alreadyRunning = Auftrag wird bereits ausgeführt; Lauf nicht gestartet
log.access.failed = kein Zugriff auf den Sicherungsordner; ZIP und Aufbewahrung werden übersprungen
log.connected = mit dem Server verbunden
log.targets = Zieldatenbanken ermittelt
log.db.cannotBackup = Datenbank kann nicht gesichert werden
log.db.skipped = Datenbank übersprungen
log.backup.started = Sicherung gestartet
log.backup.done = Sicherung beendet
log.backup.failed = Sicherung fehlgeschlagen
log.backup.sizeUnknown = Sicherungsgröße konnte nicht gelesen werden
log.zip.started = ZIP gestartet
log.zip.done = ZIP beendet
log.zip.failed = ZIP fehlgeschlagen
log.retention.done = Aufbewahrung angewendet
log.retention.failed = Aufbewahrung konnte nicht angewendet werden
log.retention.noSuccess = Aufbewahrung nicht angewendet, da keine Sicherung erfolgreich war
log.retention.deleted = alte Sicherung gelöscht
log.cli.started = über die Befehlszeile gestartet
log.gui.started = über die Benutzeroberfläche gestartet
warn.run.noLogFile = {err}; es wird nichts in die Protokolldatei geschrieben
log.run.saved = Laufprotokoll geschrieben
log.run.saveFailed = Laufprotokoll konnte nicht geschrieben werden
log.cleanup.done = alte Protokolle bereinigt
log.cleanup.failed = alte Protokolle konnten nicht bereinigt werden
log.i18n.missing = in den Sprachdateien fehlen Schlüssel

# ---------- Laufzusammenfassung ----------
summary.header = Auftrag: {job}  Server: {server}  Dauer: {elapsed}
summary.error = FEHLER: {msg}
summary.warning = WARNUNG: {msg}
summary.dbOK = [OK]   {db}  {size}  {elapsed}
summary.dbFailed = [FEHLER] {db}  {msg}
summary.dbSkipped = [ÜBERSPRUNGEN] {db}  {msg}
summary.verified = überprüft
summary.zipOK = [ZIP]  {file}  {source} → {size}  {elapsed}
summary.zipFailed = [ZIP-FEHLER] {file}  {msg}
summary.bakDeleted = .bak gelöscht
summary.deleted = [GELÖSCHT]  {file}  {size}
summary.retentionFailed = [AUFBEWAHRUNGSFEHLER] {msg}
summary.result = Ergebnis: {ok} erfolgreich, {failed} fehlgeschlagen, {skipped} übersprungen
summary.zipErrors = {count} ZIP-Fehler
summary.retentionError = Aufbewahrungsfehler
summary.exitCode = (Exitcode {code})

# ---------- Befehlszeile ----------
cli.usage = SqlBackup {version} – automatische MSSQL-Sicherung\n\nVerwendung:\n  SqlBackup.exe                            öffnet die Benutzeroberfläche\n  SqlBackup.exe run   --job <auftrag> [-v] führt den Auftrag aus (Sicherung, Überprüfung, ZIP, Aufbewahrung)\n  SqlBackup.exe test  --job <auftrag>      testet die Verbindung und den Zugriff auf den Sicherungsordner\n  SqlBackup.exe list  --job <auftrag> [--json] listet die Datenbanken auf dem Server auf\n  SqlBackup.exe batch --job <auftrag> [--path <datei.bat>]\n                                           schreibt eine Batchdatei, die den Auftrag ausführt (Standard: jobs\\<auftrag>.bat)\n  SqlBackup.exe task create|delete|run|status --job <auftrag> [--elevate] [--json]\n                                           verwaltet die geplante Aufgabe (\\SqlBackup\\<auftrag>)\n  SqlBackup.exe version                    gibt die Version aus\n\n<auftrag>: Auftragsname (gesucht in {jobsDir}) oder Pfad zu einer .json-Datei\n  -v              schreibt Protokolleinträge auch in die Konsole\n  --json          gibt die Ausgabe als JSON aus\n  --elevate       fordert bei Bedarf Administratorrechte (UAC) an\n  --lang <code>   Sprache (z. B. en, tr, de); Standard: Sprache aus den Einstellungen, sonst die Windows-Sprache\n  --home <ordner> Datenordner (Standard %ProgramData%\\SqlBackup)\n  --output <datei> schreibt die gesamte Ausgabe in eine Datei\n\nExitcodes: 0 Erfolg, 1 Teilfehler (task status: Aufgabe nicht gefunden), 2 Fehler/Einstellungsfehler, 3 Auftrag läuft bereits
cli.error = FEHLER: {msg}
cli.warning = WARNUNG: {msg}
cli.yes = ja
cli.no = nein
cli.err.unknownCommand = unbekannter Befehl: {cmd}
cli.err.unexpectedArg = unerwartetes Argument: {arg}
