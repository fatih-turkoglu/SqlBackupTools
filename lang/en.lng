# SqlBackup language file – English (default, embedded into the executable)
# Format: key = value  (UTF-8). Lines starting with "#" are comments.
# Placeholders like {name} are filled in at runtime; keep them unchanged when translating.
# Escapes: \n new line, \t tab, \\ backslash.
# To add a language: copy this file to lang\<code>.lng, set @code/@name and translate the values.
@code = en
@name = English

# ---------- Common ----------
common.unknown = unknown
common.taskDescription = Runs the SqlBackup job "{job}" (created by SqlBackup).
common.batchFiles = Batch files

# ---------- Job settings (config) ----------
err.config.nameInvalid = job name must be 1-64 characters and may only contain letters, digits, '_', '-' and '.'
err.config.nameDots = job name cannot consist of dots only
err.config.serverEmpty = server name cannot be empty
err.config.portRange = port must be between 0 and 65535
err.config.portTCPOnly = port can only be used with the TCP protocol
err.config.protocolInvalid = invalid protocol: "{value}"
err.config.userEmpty = user name is required for SQL authentication
err.config.passwordEmpty = password is required for SQL authentication
err.config.authInvalid = invalid authentication type: "{value}"
err.config.timeoutNegative = connection timeout cannot be negative
err.config.noDatabase = at least one database must be selected
err.config.serverPathEmpty = backup folder (server path) cannot be empty
err.config.commandTimeoutNegative = command timeout cannot be negative
err.config.deleteBakNeedsZip = deleting .bak after zip requires the zip option to be enabled
err.config.retentionValue = retention value must be greater than 0
err.config.retentionModeInvalid = invalid retention mode: "{value}"
err.config.scheduleTime = schedule time must be in HH:MM format (e.g. 02:00)
err.config.scheduleNoDays = at least one day must be selected for a weekly schedule
err.config.scheduleDayInvalid = invalid day: "{value}"
err.config.scheduleInterval = hourly schedule interval must be 1-23 hours
err.config.scheduleFrequencyInvalid = invalid schedule frequency: "{value}"
err.config.runAsInvalid = invalid run-as account: "{value}"
err.config.templateEmpty = file name template cannot be empty
err.config.templateNoDb = file name template must contain {db}
err.config.templateInvalidChars = file name template cannot contain \\ / : * ? " < > |
err.config.mkdir = could not create folder {path}: {err}
err.config.dirPermission = could not set permissions on folder {path}: {err}
err.config.jobRead = could not read job file: {err}
err.config.jobParse = could not parse job file ({path}): {err}
err.config.jobVersion = job file belongs to a newer version (v{version}); please update the program
err.config.settingsRead = could not read settings file: {err}
err.config.settingsParse = could not parse settings file ({path}): {err}
err.config.encrypt = could not encrypt password: {err}
err.config.decryptBase64 = encrypted value is invalid (not base64)
err.config.decrypt = could not decrypt password (was it created on another machine?): {err}

# ---------- SQL Server (mssql) ----------
err.mssql.connect = could not connect to server: {err}
err.mssql.login = SQL Server rejected the login: {err}. Check the user name and password (SQL authentication also requires "SQL Server and Windows Authentication mode" on the server). With Windows authentication, the account running the job (SYSTEM for scheduled tasks) needs a login on the server.
err.mssql.connInvalid = invalid connection settings: {err}
err.mssql.serverInfo = could not read server information: {err}
err.mssql.listDatabases = could not list databases: {err}
err.mssql.backup = could not back up {db}: {err}
err.mssql.backupHint = could not back up {db}: {err} — Hint: {hint}
err.mssql.hintAccess = The SQL Server service account (usually {account}) cannot write to this folder; grant that account Modify permission on the folder, or choose a folder it can write to.
err.mssql.hintPath = The folder was not found on the machine running SQL Server. The backup folder is resolved by the server (for a remote server it is not a path on this computer); create the folder or use a path or UNC share the server can reach.
err.mssql.hintDiskFull = There is not enough free space on the target disk; free up space or review the retention settings.
err.mssql.verify = could not verify backup ({file}): {err}
err.mssql.backupSet = could not read backup information ({db}): {err}
err.mssql.canceled = operation canceled or timed out: {err}
warn.mssql.insecureLogin = the SQL Server password is sent to the remote server without verifying its certificate; someone on the network could intercept it. Turn on encryption with certificate verification (Trust server certificate off) or use Windows authentication.

# ---------- File name template ----------
err.template.unmatchedClose = file name template has an unmatched '}'
err.template.unclosed = file name template has an unclosed '{'
err.template.unknown = unknown placeholder in file name template: {{name}}

# ---------- Backup runner ----------
err.backup.invalidJob = invalid job settings: {err}
err.backup.alreadyRunning = job "{job}" is already running; this run was not started
err.backup.lockHeld = job is already running
err.backup.lock = could not acquire job lock: {err}
err.backup.password = could not decrypt the saved password; if the job file was copied from another machine, enter the password again: {err}
err.backup.noDatabases = no databases to back up
err.backup.canceled = operation canceled
err.backup.deleteBak = zip created but .bak could not be deleted: {err}
err.backup.access = cannot access backup folder: {msg}. The folder must be readable, writable and deletable by both the SQL Server service account and the account running this program ({account}) (e.g. D:\\SqlBackups); for a remote server the access path must be a UNC path
warn.backup.noCompression = server edition ({edition}) does not support backup compression; compression disabled

reason.notFound = not found on server
reason.systemExcluded = system databases are excluded
reason.tempdb = tempdb cannot be backed up
reason.state = database is not in a state that can be backed up ({state})

