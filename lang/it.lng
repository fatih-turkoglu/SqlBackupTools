# File di lingua di SqlBackup – Italiano
# Formato: chiave = valore  (UTF-8). Le righe che iniziano con "#" sono commenti.
# I segnaposto come {name} vengono sostituiti in fase di esecuzione; non modificarli durante la traduzione.
# Sequenze di escape: \n nuova riga, \t tabulazione, \\ barra rovesciata.
@code = it
@name = Italiano

# ---------- Comune ----------
common.unknown = sconosciuto
common.taskDescription = Esegue il processo SqlBackup "{job}" (creato da SqlBackup).
common.batchFiles = File batch

# ---------- Impostazioni del processo (config) ----------
err.config.nameInvalid = il nome del processo deve avere da 1 a 64 caratteri e può contenere solo lettere, cifre, '_', '-' e '.'
err.config.nameDots = il nome del processo non può essere composto solo da punti
err.config.serverEmpty = il nome del server non può essere vuoto
err.config.portRange = la porta deve essere compresa tra 0 e 65535
err.config.portTCPOnly = la porta può essere usata solo con il protocollo TCP
err.config.protocolInvalid = protocollo non valido: "{value}"
err.config.userEmpty = il nome utente è obbligatorio per l'autenticazione SQL
err.config.passwordEmpty = la password è obbligatoria per l'autenticazione SQL
err.config.authInvalid = tipo di autenticazione non valido: "{value}"
err.config.timeoutNegative = il timeout di connessione non può essere negativo
err.config.noDatabase = è necessario selezionare almeno un database
err.config.serverPathEmpty = la cartella di backup (percorso server) non può essere vuota
err.config.commandTimeoutNegative = il timeout dei comandi non può essere negativo
err.config.deleteBakNeedsZip = per eliminare i .bak dopo lo zip l'opzione zip deve essere attivata
err.config.retentionValue = il valore di conservazione deve essere maggiore di 0
err.config.retentionModeInvalid = modalità di conservazione non valida: "{value}"
err.config.scheduleTime = l'orario della pianificazione deve essere nel formato HH:MM (ad es. 02:00)
err.config.scheduleNoDays = per una pianificazione settimanale è necessario selezionare almeno un giorno
err.config.scheduleDayInvalid = giorno non valido: "{value}"
err.config.scheduleInterval = l'intervallo della pianificazione oraria deve essere di 1-23 ore
err.config.scheduleFrequencyInvalid = frequenza di pianificazione non valida: "{value}"
err.config.runAsInvalid = account di esecuzione non valido: "{value}"
err.config.templateEmpty = il modello del nome file non può essere vuoto
err.config.templateNoDb = il modello del nome file deve contenere {db}
err.config.templateInvalidChars = il modello del nome file non può contenere \\ / : * ? " < > |
err.config.mkdir = impossibile creare la cartella {path}: {err}
err.config.dirPermission = impossibile impostare le autorizzazioni della cartella {path}: {err}
err.config.jobRead = impossibile leggere il file del processo: {err}
err.config.jobParse = impossibile analizzare il file del processo ({path}): {err}
err.config.jobVersion = il file del processo appartiene a una versione più recente (v{version}); aggiornare il programma
err.config.settingsRead = impossibile leggere il file delle impostazioni: {err}
err.config.settingsParse = impossibile analizzare il file delle impostazioni ({path}): {err}
err.config.encrypt = impossibile crittografare la password: {err}
err.config.decryptBase64 = il valore crittografato non è valido (non è base64)
err.config.decrypt = impossibile decrittografare la password (è stata creata su un altro computer?): {err}

# ---------- SQL Server (mssql) ----------
err.mssql.connect = impossibile connettersi al server: {err}
err.mssql.login = SQL Server ha rifiutato l'accesso: {err}. Verificare nome utente e password (l'autenticazione SQL richiede anche la modalità "Autenticazione di SQL Server e di Windows" sul server). Con l'autenticazione di Windows, l'account che esegue il processo (SYSTEM per le attività pianificate) deve disporre di un account di accesso sul server.
err.mssql.connInvalid = impostazioni di connessione non valide: {err}
err.mssql.serverInfo = impossibile leggere le informazioni del server: {err}
err.mssql.listDatabases = impossibile elencare i database: {err}
err.mssql.backup = impossibile eseguire il backup di {db}: {err}
err.mssql.backupHint = impossibile eseguire il backup di {db}: {err} — Suggerimento: {hint}
err.mssql.hintAccess = L'account del servizio SQL Server (di solito {account}) non può scrivere in questa cartella; concedere a tale account l'autorizzazione Modifica sulla cartella oppure scegliere una cartella in cui possa scrivere.
err.mssql.hintPath = La cartella non è stata trovata sul computer che esegue SQL Server. La cartella di backup viene risolta dal server (per un server remoto non è un percorso di questo computer); creare la cartella o usare un percorso o una condivisione UNC raggiungibile dal server.
err.mssql.hintDiskFull = Spazio libero insufficiente sul disco di destinazione; liberare spazio o rivedere le impostazioni di conservazione.
err.mssql.verify = impossibile verificare il backup ({file}): {err}
err.mssql.backupSet = impossibile leggere le informazioni del backup ({db}): {err}
err.mssql.canceled = operazione annullata o timeout scaduto: {err}
warn.mssql.insecureLogin = la password di SQL Server viene inviata al server remoto senza verificarne il certificato; qualcuno in rete potrebbe intercettarla. Attivare la crittografia con verifica del certificato ("Considera attendibile il certificato del server" disattivato) o usare l'autenticazione di Windows.

# ---------- Modello del nome file ----------
err.template.unmatchedClose = il modello del nome file contiene una '}' senza corrispondenza
err.template.unclosed = il modello del nome file contiene una '{' non chiusa
err.template.unknown = segnaposto sconosciuto nel modello del nome file: {{name}}

# ---------- Esecuzione del backup ----------
err.backup.invalidJob = impostazioni del processo non valide: {err}
err.backup.alreadyRunning = il processo "{job}" è già in esecuzione; questa esecuzione non è stata avviata
err.backup.lockHeld = il processo è già in esecuzione
err.backup.lock = impossibile ottenere il blocco del processo: {err}
err.backup.password = impossibile decrittografare la password salvata; se il file del processo è stato copiato da un altro computer, immettere di nuovo la password: {err}
err.backup.noDatabases = nessun database di cui eseguire il backup
err.backup.canceled = operazione annullata
err.backup.deleteBak = zip creato, ma impossibile eliminare il .bak: {err}
err.backup.access = impossibile accedere alla cartella di backup: {msg}. La cartella deve essere leggibile, scrivibile ed eliminabile sia dall'account del servizio SQL Server sia dall'account che esegue questo programma ({account}) (ad es. D:\\SqlBackups); per un server remoto il percorso di accesso deve essere un percorso UNC
warn.backup.noCompression = l'edizione del server ({edition}) non supporta la compressione dei backup; compressione disattivata

reason.notFound = non trovato sul server
reason.systemExcluded = i database di sistema sono esclusi
reason.tempdb = non è possibile eseguire il backup di tempdb
reason.state = il database non è in uno stato che consente il backup ({state})

# ---------- Conservazione ----------
err.retention.readDir = impossibile leggere la cartella di backup: {err}
err.retention.delete = impossibile eliminare alcuni backup vecchi: {err}
warn.retention.noDate = conservazione non applicata perché il modello del nome file non contiene una data (anno, mese e giorno)
warn.retention.canceled = operazione annullata; conservazione non applicata

# ---------- ZIP (archive) ----------
err.archive.dirNotFound = cartella non trovata: {path}
err.archive.dirNoPermission = nessuna autorizzazione per accedere alla cartella: {path}
err.archive.dirAccess = impossibile accedere alla cartella: {err}
err.archive.notDir = il percorso non è una cartella: {path}
err.archive.noWrite = nessuna autorizzazione di scrittura sulla cartella ({path}): {err}
err.archive.write = impossibile scrivere nella cartella ({path}): {err}
err.archive.noRead = nessuna autorizzazione di lettura sulla cartella ({path}): {err}
err.archive.noDelete = nessuna autorizzazione di eliminazione sulla cartella ({path}): {err}
err.archive.noFiles = nessun file da comprimere
err.archive.readBak = impossibile leggere il file di backup: {err}
err.archive.duplicateName = uno zip non può contenere due file con lo stesso nome: {name}
err.archive.rename = impossibile rinominare il file zip: {err}
err.archive.create = impossibile creare il file zip: {err}
err.archive.writeZip = impossibile scrivere il file zip: {err}
err.archive.entry = impossibile creare la voce zip: {err}
err.archive.canceled = zip annullato: {err}
err.archive.compress = impossibile comprimere {name}: {err}
err.archive.verify = verifica dello zip non riuscita: {err}
err.archive.verifyEntry = verifica dello zip non riuscita ({name}): {err}
err.archive.verifyCount = verifica dello zip non riuscita: previste {want} voci, trovate {got}
err.archive.verifyUnexpected = verifica dello zip non riuscita: voce imprevista {name}
err.archive.verifySize = verifica dello zip non riuscita: dimensione non corrispondente per {name} ({got} / {want})
err.archive.verifyReadSize = verifica dello zip non riuscita: dimensione letta non corrispondente per {name}

# ---------- Registrazione ----------
err.logging.mkdir = impossibile creare la cartella dei log: {err}
err.logging.open = impossibile aprire il file di log: {err}
err.logging.runsMkdir = impossibile creare la cartella dei report di esecuzione: {err}
err.logging.runWrite = impossibile scrivere il report di esecuzione: {err}
err.logging.runRead = impossibile leggere il report di esecuzione: {err}
err.logging.runParse = impossibile analizzare il report di esecuzione ({path}): {err}
err.logging.cleanup = impossibile eliminare alcuni file di log vecchi: {err}

# ---------- File batch e attività pianificata (scheduler) ----------
err.scheduler.exePath = impossibile determinare il percorso del programma: {err}
err.scheduler.path = percorso non valido {path}: {err}
err.scheduler.badPath = il percorso non può essere usato in una riga di comando: "{path}"
err.scheduler.percentPath = il percorso contiene caratteri "%", che l'Utilità di pianificazione espande come variabili di ambiente: {path}
err.scheduler.batchWrite = impossibile scrivere il file batch {path}: {err}
err.scheduler.noUser = impossibile determinare l'account utente per l'attività
err.scheduler.accessDenied = l'Utilità di pianificazione ha negato l'accesso (sono necessari i diritti di amministratore)
err.scheduler.notFound = attività pianificata non trovata
err.scheduler.connect = impossibile connettersi all'Utilità di pianificazione: {err}
err.scheduler.create = impossibile creare l'attività pianificata: {err}
err.scheduler.delete = impossibile eliminare l'attività pianificata: {err}
err.scheduler.run = impossibile avviare l'attività pianificata: {err}
err.scheduler.query = impossibile leggere l'attività pianificata: {err}
err.scheduler.elevate = impossibile avviare con i diritti di amministratore: {err}
err.scheduler.elevateCancelled = i diritti di amministratore non sono stati concessi (richiesta UAC annullata)
err.scheduler.exeCheck = impossibile verificare le autorizzazioni di {path}: {err}
err.scheduler.unsafeExe = un'attività SYSTEM non può eseguire {exe}: {account} può modificare {path} e quindi eseguire codice proprio come SYSTEM. Installare il programma con il programma di installazione (Program Files) o usare una cartella in cui possono scrivere solo gli amministratori.
warn.scheduler.systemWindowsAuth = l'attività viene eseguita come SYSTEM con l'autenticazione di Windows: SQL Server richiede un account di accesso per NT AUTHORITY\\SYSTEM (DOMINIO\\COMPUTER$ per un server remoto) con autorizzazione di backup
warn.scheduler.systemNetworkPath = l'attività viene eseguita come SYSTEM: alla cartella di rete {path} si accede con l'account computer (DOMINIO\\COMPUTER$), che richiede autorizzazioni di lettura, scrittura ed eliminazione
warn.scheduler.currentUser = l'attività viene eseguita solo mentre {user} è connesso

# ---------- Backend dell'interfaccia (app) ----------
err.app.jobNotFound = processo non trovato: {job}
err.app.jobExists = esiste già un processo denominato "{job}"
err.app.alreadyRunning = il processo "{job}" è già in esecuzione
err.app.renameRunning = il processo "{job}" è in esecuzione; non può essere rinominato ora
err.app.deleteRunning = il processo "{job}" è in esecuzione; non può essere eliminato ora
err.app.elevatedExit = il comando eseguito con i diritti di amministratore non è riuscito (codice di uscita {code})
err.app.pathOutside = il file non si trova nella cartella dei log: {path}
err.app.keepDays = la conservazione dei log non può essere negativa
err.app.theme = tema sconosciuto: {theme}
warn.app.renamedTask = l'attività pianificata del vecchio nome ({path}) esegue ancora il vecchio processo e non riuscirà; eliminarla e creare di nuovo l'attività
warn.app.renamedBatch = il file batch del vecchio nome ({path}) esegue ancora il vecchio processo
warn.app.taskOutdated = l'attività pianificata ({path}) non corrisponde alle impostazioni salvate; aggiornare l'attività

# ---------- Messaggi di log ----------
log.job.started = processo avviato
log.job.done = processo terminato
log.job.failed = impossibile eseguire il processo
log.job.alreadyRunning = il processo è già in esecuzione; esecuzione non avviata
log.access.failed = impossibile accedere alla cartella di backup; zip e conservazione verranno saltati
log.connected = connesso al server
log.targets = database di destinazione determinati
log.db.cannotBackup = impossibile eseguire il backup del database
log.db.skipped = database saltato
log.backup.started = backup avviato
log.backup.done = backup terminato
log.backup.failed = backup non riuscito
log.backup.sizeUnknown = impossibile leggere la dimensione del backup
log.zip.started = zip avviato
log.zip.done = zip terminato
log.zip.failed = zip non riuscito
log.retention.done = conservazione applicata
log.retention.failed = impossibile applicare la conservazione
log.retention.noSuccess = conservazione non applicata perché nessun backup è riuscito
log.retention.deleted = backup vecchio eliminato
log.cli.started = avviato dalla riga di comando
log.gui.started = avviato dall'interfaccia utente
warn.run.noLogFile = {err}; non verrà scritto nulla nel file di log
log.run.saved = report di esecuzione scritto
log.run.saveFailed = impossibile scrivere il report di esecuzione
log.cleanup.done = log vecchi eliminati
log.cleanup.failed = impossibile eliminare i log vecchi
log.i18n.missing = nei file di lingua mancano alcune chiavi

# ---------- Riepilogo dell'esecuzione ----------
summary.header = Processo: {job}  Server: {server}  Durata: {elapsed}
summary.error = ERRORE: {msg}
summary.warning = AVVISO: {msg}
summary.dbOK = [OK]   {db}  {size}  {elapsed}
summary.dbFailed = [ERRORE] {db}  {msg}
summary.dbSkipped = [SALTATO] {db}  {msg}
summary.verified = verificato
summary.zipOK = [ZIP]  {file}  {source} → {size}  {elapsed}
summary.zipFailed = [ERRORE ZIP] {file}  {msg}
summary.bakDeleted = .bak eliminato
summary.deleted = [ELIM]  {file}  {size}
summary.retentionFailed = [ERRORE CONSERVAZIONE] {msg}
summary.result = Risultato: {ok} riusciti, {failed} non riusciti, {skipped} saltati
summary.zipErrors = {count} errore/i zip
summary.retentionError = errore di conservazione
summary.exitCode = (codice di uscita {code})

# ---------- Riga di comando ----------
cli.usage = SqlBackup {version} – backup automatico di MSSQL\n\nUso:\n  SqlBackup.exe                            apre l'interfaccia utente\n  SqlBackup.exe run   --job <processo> [-v] esegue il processo (backup, verifica, zip, conservazione)\n  SqlBackup.exe test  --job <processo>     verifica la connessione e l'accesso alla cartella di backup\n  SqlBackup.exe list  --job <processo> [--json] elenca i database sul server\n  SqlBackup.exe batch --job <processo> [--path <file.bat>]\n                                           scrive un file batch che esegue il processo (predefinito: jobs\\<processo>.bat)\n  SqlBackup.exe task create|delete|run|status --job <processo> [--elevate] [--json]\n                                           gestisce l'attività pianificata (\\SqlBackup\\<processo>)\n  SqlBackup.exe version                    mostra la versione\n\n<processo>: nome del processo (cercato in {jobsDir}) o percorso di un file .json\n  -v              scrive le voci di log anche nella console\n  --json          scrive l'output in formato JSON\n  --elevate       richiede i diritti di amministratore (UAC) quando necessario\n  --lang <codice> lingua (ad es. en, tr, it); predefinita: la lingua delle impostazioni, altrimenti quella di Windows\n  --home <cartella> cartella dei dati (predefinita %ProgramData%\\SqlBackup)\n  --output <file> scrive tutto l'output in un file\n\nCodici di uscita: 0 riuscito, 1 errore parziale (task status: attività non trovata), 2 errore/errore di impostazioni, 3 processo già in esecuzione
cli.error = ERRORE: {msg}
cli.warning = AVVISO: {msg}
cli.yes = sì
cli.no = no
