# SqlBackup dil dosyası – Türkçe
# Biçim: anahtar = değer  (UTF-8). "#" ile başlayan satırlar yorumdur.
# {ad} biçimindeki yer tutucular çalışma anında doldurulur; çevirirken aynen korunmalı.
# Kaçışlar: \n satır sonu, \t sekme, \\ ters bölü.
@code = tr
@name = Türkçe

# ---------- Ortak ----------
common.unknown = bilinmiyor
common.taskDescription = SqlBackup "{job}" işini çalıştırır (SqlBackup tarafından oluşturuldu).
common.batchFiles = Batch dosyaları

# ---------- İş ayarları (config) ----------
err.config.nameInvalid = iş adı 1-64 karakter olmalı; yalnızca harf, rakam, '_', '-' ve '.' içerebilir
err.config.nameDots = iş adı yalnızca noktadan oluşamaz
err.config.serverEmpty = sunucu adı boş olamaz
err.config.portRange = port 0-65535 aralığında olmalı
err.config.portTCPOnly = port yalnızca TCP protokolünde kullanılabilir
err.config.protocolInvalid = geçersiz protokol: "{value}"
err.config.userEmpty = SQL kimlik doğrulamasında kullanıcı adı boş olamaz
err.config.passwordEmpty = SQL kimlik doğrulamasında şifre girilmeli
err.config.authInvalid = geçersiz kimlik doğrulama tipi: "{value}"
err.config.timeoutNegative = bağlantı zaman aşımı negatif olamaz
err.config.noDatabase = en az bir veritabanı seçilmeli
err.config.serverPathEmpty = yedek klasörü (sunucu yolu) boş olamaz
err.config.commandTimeoutNegative = komut zaman aşımı negatif olamaz
err.config.deleteBakNeedsZip = zip sonrası .bak silme için zip seçeneği açık olmalı
err.config.retentionValue = saklama değeri 0'dan büyük olmalı
err.config.retentionModeInvalid = geçersiz saklama modu: "{value}"
err.config.scheduleTime = zamanlama saati SS:DD formatında olmalı (ör. 02:00)
err.config.scheduleNoDays = haftalık zamanlamada en az bir gün seçilmeli
err.config.scheduleDayInvalid = geçersiz gün: "{value}"
err.config.scheduleInterval = saatlik zamanlamada aralık 1-23 saat olmalı
err.config.scheduleFrequencyInvalid = geçersiz zamanlama sıklığı: "{value}"
err.config.runAsInvalid = geçersiz çalışma hesabı: "{value}"
err.config.templateEmpty = dosya adı şablonu boş olamaz
err.config.templateNoDb = dosya adı şablonu {db} içermeli
err.config.templateInvalidChars = dosya adı şablonu \\ / : * ? " < > | karakterlerini içeremez
err.config.mkdir = klasör oluşturulamadı {path}: {err}
err.config.dirPermission = {path} klasörünün izinleri ayarlanamadı: {err}
err.config.jobRead = iş dosyası okunamadı: {err}
err.config.jobParse = iş dosyası çözümlenemedi ({path}): {err}
err.config.jobVersion = iş dosyası daha yeni bir sürüme ait (v{version}), programı güncelleyin
err.config.settingsRead = ayarlar dosyası okunamadı: {err}
err.config.settingsParse = ayarlar dosyası çözümlenemedi ({path}): {err}
err.config.encrypt = şifre şifrelenemedi: {err}
err.config.decryptBase64 = şifreli değer geçersiz (base64 değil)
err.config.decrypt = şifre çözülemedi (başka bir makinede mi oluşturuldu?): {err}

# ---------- SQL Server (mssql) ----------
err.mssql.connect = sunucuya bağlanılamadı: {err}
err.mssql.login = SQL Server girişi reddetti: {err}. Kullanıcı adı ve şifreyi kontrol edin (SQL kimlik doğrulaması sunucuda "SQL Server ve Windows Kimlik Doğrulaması modu" da gerektirir). Windows kimlik doğrulamasında işi çalıştıran hesabın (zamanlanmış görevde SYSTEM) sunucuda bir girişi olmalıdır.
err.mssql.connInvalid = bağlantı bilgisi geçersiz: {err}
err.mssql.serverInfo = sunucu bilgisi okunamadı: {err}
err.mssql.listDatabases = veritabanları listelenemedi: {err}
err.mssql.backup = {db} yedeklenemedi: {err}
err.mssql.backupHint = {db} yedeklenemedi: {err} — İpucu: {hint}
err.mssql.hintAccess = SQL Server servis hesabı (genellikle {account}) bu klasöre yazamıyor; klasörde bu hesaba Değiştirme izni verin veya hesabın yazabildiği bir klasör seçin.
err.mssql.hintPath = Klasör, SQL Server'ın çalıştığı makinede bulunamadı. Yedek klasörü sunucunun bakış açısından yorumlanır (uzak sunucuda bu bilgisayardaki bir yol değildir); klasörü oluşturun veya sunucunun erişebildiği bir yol/UNC paylaşımı kullanın.
err.mssql.hintDiskFull = Hedef diskte yeterli boş alan yok; yer açın veya saklama (retention) ayarlarını gözden geçirin.
err.mssql.verify = yedek doğrulanamadı ({file}): {err}
err.mssql.backupSet = yedek bilgisi okunamadı ({db}): {err}
err.mssql.canceled = işlem iptal edildi veya zaman aşımına uğradı: {err}

# ---------- Dosya adı şablonu ----------
err.template.unmatchedClose = dosya adı şablonunda eşleşmeyen '}' var
err.template.unclosed = dosya adı şablonunda kapanmamış '{' var
err.template.unknown = dosya adı şablonunda bilinmeyen yer tutucu: {{name}}

# ---------- Yedek çalıştırıcı ----------
err.backup.invalidJob = iş ayarları geçersiz: {err}
err.backup.alreadyRunning = "{job}" işi zaten çalışıyor; bu çalışma başlatılmadı
err.backup.lockHeld = iş zaten çalışıyor
err.backup.lock = iş kilidi alınamadı: {err}
err.backup.password = kayıtlı şifre çözülemedi; iş dosyası başka bir makineden kopyalandıysa şifreyi yeniden girin: {err}
err.backup.noDatabases = yedeklenecek veritabanı bulunamadı
err.backup.canceled = işlem iptal edildi
err.backup.deleteBak = zip oluşturuldu ancak .bak silinemedi: {err}
err.backup.access = yedek klasörüne erişilemiyor: {msg}. Klasör hem SQL Server servis hesabının hem de bu programı çalıştıran hesabın ({account}) okuma/yazma/silme izni olan bir yer olmalı (ör. D:\\SqlBackups); uzak sunucuda erişim yolu bir UNC yolu olmalı
warn.backup.noCompression = sunucu sürümü ({edition}) yedek sıkıştırmayı desteklemiyor; sıkıştırma kapatıldı

reason.notFound = sunucuda bulunamadı
reason.systemExcluded = sistem veritabanları hariç tutuluyor
reason.tempdb = tempdb yedeklenemez
reason.state = veritabanı yedeklenebilir durumda değil ({state})

# ---------- Saklama (retention) ----------
err.retention.readDir = yedek klasörü okunamadı: {err}
err.retention.delete = bazı eski yedekler silinemedi: {err}
warn.retention.noDate = dosya adı şablonunda tarih (yıl, ay ve gün) olmadığı için saklama kuralı uygulanmadı
warn.retention.canceled = işlem iptal edildi; saklama kuralı uygulanmadı

# ---------- ZIP (archive) ----------
err.archive.dirNotFound = klasör bulunamadı: {path}
err.archive.dirNoPermission = klasöre erişim izni yok: {path}
err.archive.dirAccess = klasöre erişilemiyor: {err}
err.archive.notDir = yol bir klasör değil: {path}
err.archive.noWrite = klasöre yazma izni yok ({path}): {err}
err.archive.write = klasöre yazılamıyor ({path}): {err}
err.archive.noRead = klasörden okuma izni yok ({path}): {err}
err.archive.noDelete = klasörde silme izni yok ({path}): {err}
err.archive.noFiles = zip'lenecek dosya yok
err.archive.readBak = yedek dosyası okunamadı: {err}
err.archive.duplicateName = zip içinde aynı adda iki dosya olamaz: {name}
err.archive.rename = zip dosyası adlandırılamadı: {err}
err.archive.create = zip dosyası oluşturulamadı: {err}
err.archive.writeZip = zip dosyası yazılamadı: {err}
err.archive.entry = zip girdisi oluşturulamadı: {err}
err.archive.canceled = zip iptal edildi: {err}
err.archive.compress = {name} zip'lenemedi: {err}
err.archive.verify = zip doğrulanamadı: {err}
err.archive.verifyEntry = zip doğrulanamadı ({name}): {err}
err.archive.verifyCount = zip doğrulanamadı: {want} girdi bekleniyordu, {got} bulundu
err.archive.verifyUnexpected = zip doğrulanamadı: beklenmeyen girdi {name}
err.archive.verifySize = zip doğrulanamadı: {name} boyutu uyuşmuyor ({got} / {want})
err.archive.verifyReadSize = zip doğrulanamadı: {name} okunan boyut uyuşmuyor

# ---------- Loglama ----------
err.logging.mkdir = log klasörü oluşturulamadı: {err}
err.logging.open = log dosyası açılamadı: {err}
err.logging.runsMkdir = çalışma kaydı klasörü oluşturulamadı: {err}
err.logging.runWrite = çalışma kaydı yazılamadı: {err}
err.logging.runRead = çalışma kaydı okunamadı: {err}
err.logging.runParse = çalışma kaydı çözümlenemedi ({path}): {err}
err.logging.cleanup = bazı eski log dosyaları silinemedi: {err}

# ---------- Batch dosyası ve zamanlanmış görev (scheduler) ----------
err.scheduler.exePath = program yolu belirlenemedi: {err}
err.scheduler.path = geçersiz yol {path}: {err}
err.scheduler.badPath = yol komut satırında kullanılamaz: "{path}"
err.scheduler.percentPath = yol "%" karakterleri içeriyor; Görev Zamanlayıcı bunları ortam değişkeni olarak genişletir: {path}
err.scheduler.batchWrite = batch dosyası yazılamadı {path}: {err}
err.scheduler.noUser = görevin kullanıcı hesabı belirlenemedi
err.scheduler.accessDenied = Görev Zamanlayıcı erişimi reddetti (yönetici yetkisi gerekiyor)
err.scheduler.notFound = zamanlanmış görev bulunamadı
err.scheduler.connect = Görev Zamanlayıcı'ya bağlanılamadı: {err}
err.scheduler.create = zamanlanmış görev oluşturulamadı: {err}
err.scheduler.delete = zamanlanmış görev silinemedi: {err}
err.scheduler.run = zamanlanmış görev başlatılamadı: {err}
err.scheduler.query = zamanlanmış görev okunamadı: {err}
err.scheduler.elevate = yönetici yetkisiyle başlatılamadı: {err}
err.scheduler.elevateCancelled = yönetici yetkisi verilmedi (UAC isteği iptal edildi)
warn.scheduler.systemWindowsAuth = görev SYSTEM hesabıyla ve Windows kimlik doğrulamasıyla çalışır: SQL Server'da NT AUTHORITY\\SYSTEM (uzak sunucuda DOMAIN\\BILGISAYAR$) için yedek yetkisi olan bir login gerekir
warn.scheduler.systemNetworkPath = görev SYSTEM hesabıyla çalışır: {path} ağ klasörüne bilgisayar hesabıyla (DOMAIN\\BILGISAYAR$) erişilir; bu hesabın okuma, yazma ve silme izni olmalı
warn.scheduler.currentUser = görev yalnızca {user} oturum açmışken çalışır

# ---------- Arayüz backend'i (app) ----------
err.app.jobNotFound = iş bulunamadı: {job}
err.app.jobExists = "{job}" adında bir iş zaten var
err.app.alreadyRunning = "{job}" işi zaten çalışıyor
err.app.renameRunning = "{job}" işi çalışıyor; şu anda yeniden adlandırılamaz
err.app.deleteRunning = "{job}" işi çalışıyor; şu anda silinemez
err.app.elevatedExit = yönetici yetkisiyle çalıştırılan komut başarısız oldu (çıkış kodu {code})
err.app.pathOutside = dosya log klasöründe değil: {path}
err.app.keepDays = log saklama süresi negatif olamaz
err.app.theme = bilinmeyen tema: {theme}
warn.app.renamedTask = eski adın zamanlanmış görevi ({path}) hâlâ eski işi çalıştırıyor ve başarısız olacak; silip görevi yeniden oluşturun
warn.app.renamedBatch = eski adın batch dosyası ({path}) hâlâ eski işi çalıştırıyor
warn.app.taskOutdated = zamanlanmış görev ({path}) kaydedilen ayarlarla uyuşmuyor; görevi güncelleyin

# ---------- Log mesajları ----------
log.job.started = iş başladı
log.job.done = iş tamamlandı
log.job.failed = iş çalıştırılamadı
log.job.alreadyRunning = iş zaten çalışıyor; çalışma başlatılmadı
log.access.failed = yedek klasörüne erişilemiyor; zip ve saklama yapılmayacak
log.connected = sunucuya bağlanıldı
log.targets = hedef veritabanları belirlendi
log.db.cannotBackup = veritabanı yedeklenemiyor
log.db.skipped = veritabanı atlandı
log.backup.started = yedek başlıyor
log.backup.done = yedek tamamlandı
log.backup.failed = yedek başarısız
log.backup.sizeUnknown = yedek boyutu okunamadı
log.zip.started = zip başlıyor
log.zip.done = zip tamamlandı
log.zip.failed = zip başarısız
log.retention.done = saklama kuralı uygulandı
log.retention.failed = saklama kuralı uygulanamadı
log.retention.noSuccess = başarılı yedek olmadığı için saklama kuralı uygulanmadı
log.retention.deleted = eski yedek silindi
log.cli.started = komut satırından çalıştırıldı
log.gui.started = arayüzden çalıştırıldı
warn.run.noLogFile = {err}; log dosyasına yazılmayacak
log.run.saved = çalışma kaydı yazıldı
log.run.saveFailed = çalışma kaydı yazılamadı
log.cleanup.done = eski loglar temizlendi
log.cleanup.failed = eski loglar temizlenemedi
log.i18n.missing = dil dosyalarında eksik anahtarlar var

# ---------- Çalışma özeti ----------
summary.header = İş: {job}  Sunucu: {server}  Süre: {elapsed}
summary.error = HATA: {msg}
summary.warning = UYARI: {msg}
summary.dbOK = [OK]   {db}  {size}  {elapsed}
summary.dbFailed = [HATA] {db}  {msg}
summary.dbSkipped = [ATLA] {db}  {msg}
summary.verified = doğrulandı
summary.zipOK = [ZIP]  {file}  {source} → {size}  {elapsed}
summary.zipFailed = [ZIP HATA] {file}  {msg}
summary.bakDeleted = .bak silindi
summary.deleted = [SİL]  {file}  {size}
summary.retentionFailed = [SAKLAMA HATA] {msg}
summary.result = Sonuç: {ok} başarılı, {failed} hatalı, {skipped} atlandı
summary.zipErrors = {count} zip hatası
summary.retentionError = saklama hatası
summary.exitCode = (çıkış kodu {code})

# ---------- Komut satırı ----------
cli.usage = SqlBackup {version} – MSSQL otomatik yedekleme\n\nKullanım:\n  SqlBackup.exe                            arayüzü açar\n  SqlBackup.exe run   --job <iş> [-v]      işi çalıştırır (yedek, doğrulama, zip, saklama)\n  SqlBackup.exe test  --job <iş>           bağlantıyı ve yedek klasörü erişimini sınar\n  SqlBackup.exe list  --job <iş> [--json]  sunucudaki veritabanlarını listeler\n  SqlBackup.exe batch --job <iş> [--path <dosya.bat>]\n                                           işi çalıştıran batch dosyasını yazar (varsayılan: jobs\\<iş>.bat)\n  SqlBackup.exe task create|delete|run|status --job <iş> [--elevate] [--json]\n                                           zamanlanmış görevi yönetir (\\SqlBackup\\<iş>)\n  SqlBackup.exe version                    sürümü yazar\n\n<iş>: iş adı ({jobsDir} içinde aranır) veya .json dosya yolu\n  -v               log kayıtlarını konsola da yazar\n  --json           çıktıyı JSON olarak yazar\n  --elevate        gerektiğinde yönetici yetkisi ister (UAC)\n  --lang <kod>     dil (ör. en, tr); varsayılan ayarlardaki dil\n  --home <klasör>  veri klasörü (varsayılan %ProgramData%\\SqlBackup)\n  --output <dosya> tüm çıktıyı dosyaya yazar\n\nÇıkış kodları: 0 başarılı, 1 kısmi hata (task status: görev yok), 2 başarısız/ayar hatası, 3 iş zaten çalışıyor
cli.error = HATA: {msg}
cli.warning = UYARI: {msg}
