{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "SqlBackup",
  "outputfilename": "SqlBackup",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "postBuildHooks": {
    "windows/*": "powershell -NoProfile -NonInteractive -Command \"New-Item -ItemType Directory -Force lang | Out-Null; Copy-Item ../../lang/*.lng lang -Force\""
  },
  "author": {
    "name": "Fatih TÜRKOĞLU",
    "email": "mbrroot@gmail.com"
  },
  "info": {
    "companyName": "Fatih TÜRKOĞLU",
    "productName": "SqlBackup",
    "productVersion": "0.5.0",
    "copyright": "Copyright © 2026 Fatih TÜRKOĞLU",
    "comments": "MSSQL automatic backup"
  }
}
