cli.err.connect = Verbindung fehlgeschlagen: {err}
cli.warn.language = Sprache konnte nicht geladen werden ({code}): {err}
cli.phase.backup = Sicherung
cli.phase.verify = Überprüfung
cli.phase.zip = ZIP
