err.archive.duplicateName = a zip cannot contain two files with the same name: {name}
err.archive.rename = could not rename zip file: {err}
err.archive.create = could not create zip file: {err}
err.archive.writeZip = could not write zip file: {err}
err.archive.entry = could not create zip entry: {err}
err.archive.canceled = zip canceled: {err}
