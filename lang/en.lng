summary.zipFailed = [ZIP FAIL] {file}  {msg}
summary.bakDeleted = .bak deleted
summary.deleted = [DEL]  {file}  {size}
summary.retentionFailed = [RETENTION FAIL] {msg}
summary.result = Result: {ok} succeeded, {failed} failed, {skipped} skipped
summary.zipErrors = {count} zip error(s)
summary.retentionError = retention error
summary.exitCode = (exit code {code})

# ---------- Command line ----------
cli.usage = SqlBackup {version} – automatic MSSQL backup\n\nUsage:\n  SqlBackup.exe                            opens the user interface\n  SqlBackup.exe run   --job <job> [-v]     runs the job (backup, verify, zip, retention)\n  SqlBackup.exe test  --job <job>          tests the connection and backup folder access\n  SqlBackup.exe list  --job <job> [--json] lists the databases on the server\n  SqlBackup.exe batch --job <job> [--path <file.bat>]\n                                           writes a batch file that runs the job (default: jobs\\<job>.bat)\n  SqlBackup.exe task create|delete|run|status --job <job> [--elevate] [--json]\n                                           manages the scheduled task (\\SqlBackup\\<job>)\n  SqlBackup.exe version                    prints the version\n\n<job>: job name (looked up in {jobsDir}) or path to a .json file\n  -v              also writes log entries to the console\n  --json          writes the output as JSON\n  --elevate       asks for administrator rights (UAC) when needed\n  --lang <code>   language (e.g. en, tr, de); default: the language in settings, otherwise the Windows language\n  --home <folder> data folder (default %ProgramData%\\SqlBackup)\n  --output <file> writes all output to a file\n\nExit codes: 0 success, 1 partial failure (task status: task not found), 2 failure/settings error, 3 job already running
cli.error = ERROR: {msg}
cli.warning = WARNING: {msg}
cli.yes = yes
cli.no = no
cli.err.unknownCommand = unknown command: {cmd}
cli.err.unexpectedArg = unexpected argument: {arg}
cli.err.noJob = --job not specified
cli.err.jobNotFound = job file not found: {path}
cli.err.connect = could not connect: {err}
cli.warn.language = could not load language ({code}): {err}
