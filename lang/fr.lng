# ---------- GUI : Sauvegarde ----------
gui.backup.folders = Dossier de sauvegarde
gui.backup.serverPath = Dossier sur le SQL Server (chemin serveur)
gui.backup.serverPathHint = SQL Server écrit la sauvegarde ici, tel que vu depuis l'ordinateur SQL Server (par ex. D:\\SqlBackups).
gui.backup.useServerDefault = Valeur par défaut du serveur
gui.backup.accessPath = Même dossier vu depuis ce programme (chemin d'accès)
gui.backup.accessPathHint = Laissez vide pour un serveur local. Pour un serveur distant, saisissez le chemin du partage (par ex. \\\\SRV01\\SqlBackups). Nécessaire pour le ZIP et la rétention.
gui.backup.checkAccess = Vérifier l'accès
gui.backup.noFolder = Saisissez d'abord un dossier.
gui.backup.accessOk = Ce programme peut lire, écrire et supprimer dans {path}.
gui.backup.accessFailed = Aucun accès à {path} : {error}
gui.backup.pathsInfo = Le fichier de sauvegarde est écrit par le compte de service SQL Server (par ex. NT Service\\MSSQL$SQLEXPRESS), et non par ce programme. Choisissez un dossier accessible à la fois au compte de service et au compte qui exécute la tâche, par ex. D:\\SqlBackups (le dossier par défaut sous Program Files refuse généralement l'accès aux autres comptes).
gui.backup.fileName = Nom de fichier
gui.backup.template = Modèle de nom de fichier
gui.backup.templateHint = {db} est obligatoire. Également : {server}, {job} et des parties de date comme {yyyyMMdd}, {HHmmss}, {yyyy-MM-dd}. .bak est ajouté s'il manque.
gui.backup.preview = Exemple :
gui.backup.options = Options
gui.backup.compression = Compression
gui.backup.checksum = Somme de contrôle
gui.backup.copyOnly = Sauvegarde en copie seule
gui.backup.copyOnlyHint = Les sauvegardes en copie seule n'affectent pas la chaîne de sauvegarde des autres outils de sauvegarde.
gui.backup.verify = Vérifier après la sauvegarde (RESTORE VERIFYONLY)
gui.backup.commandTimeout = Délai d'exécution des commandes (minutes)
gui.backup.commandTimeoutHint = 0 = illimité.
gui.backup.compressionUnsupported = Le serveur connecté ne prend pas en charge la compression (Express/Web) ; elle sera désactivée à l'exécution.

