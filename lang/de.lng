cli.batch.saved = Batchdatei gespeichert: {path}
cli.err.noTaskCommand = Aufgabenbefehl nicht angegeben (create, delete, run, status)
cli.err.unknownTaskCommand = unbekannter Aufgabenbefehl: {cmd} (create, delete, run, status)
cli.err.needAdmin = {err}; führen Sie den Befehl in einer Administrator-Eingabeaufforderung aus oder fügen Sie --elevate hinzu
