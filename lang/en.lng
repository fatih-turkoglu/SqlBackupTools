# ---------- Batch file and scheduled task (scheduler) ----------
err.scheduler.exePath = could not determine the program path: {err}
err.scheduler.path = invalid path {path}: {err}
err.scheduler.badPath = path cannot be used on a command line: "{path}"
err.scheduler.percentPath = path contains "%" characters, which Task Scheduler expands as environment variables: {path}
err.scheduler.batchWrite = could not write batch file {path}: {err}
err.scheduler.noUser = could not determine the user account for the task
err.scheduler.accessDenied = Task Scheduler denied access (administrator rights are required)
err.scheduler.notFound = scheduled task not found
err.scheduler.connect = could not connect to Task Scheduler: {err}
err.scheduler.create = could not create the scheduled task: {err}
err.scheduler.delete = could not delete the scheduled task: {err}
err.scheduler.run = could not start the scheduled task: {err}
err.scheduler.query = could not read the scheduled task: {err}
err.scheduler.elevate = could not start with administrator rights: {err}
err.scheduler.elevateCancelled = administrator rights were not granted (UAC prompt cancelled)
err.scheduler.exeCheck = could not check the permissions of {path}: {err}
err.scheduler.unsafeExe = a SYSTEM task cannot run {exe}: {account} can modify {path}, so it could run its own code as SYSTEM. Install the program with the installer (Program Files) or use a folder only administrators can write to.
warn.scheduler.systemWindowsAuth = the task runs as SYSTEM with Windows authentication: SQL Server needs a login for NT AUTHORITY\\SYSTEM (DOMAIN\\COMPUTER$ for a remote server) with backup permission
warn.scheduler.systemNetworkPath = the task runs as SYSTEM: the network folder {path} is accessed with the computer account (DOMAIN\\COMPUTER$), which needs read, write and delete permission
warn.scheduler.currentUser = the task runs only while {user} is logged on

