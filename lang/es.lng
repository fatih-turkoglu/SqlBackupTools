# Archivo de idioma de SqlBackup – Español
# Formato: clave = valor  (UTF-8). Las líneas que empiezan por "#" son comentarios.
# Los marcadores como {name} se rellenan en tiempo de ejecución; no los cambie al traducir.
# Secuencias de escape: \n nueva línea, \t tabulación, \\ barra invertida.
@code = es
@name = Español

# ---------- Común ----------
common.unknown = desconocido
common.taskDescription = Ejecuta el trabajo de SqlBackup "{job}" (creado por SqlBackup).
common.batchFiles = Archivos por lotes

# ---------- Configuración del trabajo (config) ----------
err.config.nameInvalid = el nombre del trabajo debe tener entre 1 y 64 caracteres y solo puede contener letras, dígitos, '_', '-' y '.'
err.config.nameDots = el nombre del trabajo no puede estar formado solo por puntos
err.config.serverEmpty = el nombre del servidor no puede estar vacío
err.config.portRange = el puerto debe estar entre 0 y 65535
err.config.portTCPOnly = el puerto solo se puede usar con el protocolo TCP
err.config.protocolInvalid = protocolo no válido: "{value}"
err.config.userEmpty = el nombre de usuario es obligatorio para la autenticación de SQL
err.config.passwordEmpty = la contraseña es obligatoria para la autenticación de SQL
err.config.authInvalid = tipo de autenticación no válido: "{value}"
err.config.timeoutNegative = el tiempo de espera de conexión no puede ser negativo
err.config.noDatabase = se debe seleccionar al menos una base de datos
err.config.serverPathEmpty = la carpeta de copia de seguridad (ruta del servidor) no puede estar vacía
err.config.commandTimeoutNegative = el tiempo de espera de comandos no puede ser negativo
err.config.deleteBakNeedsZip = para eliminar los .bak después del zip, la opción zip debe estar activada
err.config.retentionValue = el valor de retención debe ser mayor que 0
err.config.retentionModeInvalid = modo de retención no válido: "{value}"
err.config.scheduleTime = la hora de la programación debe tener el formato HH:MM (p. ej. 02:00)
err.config.scheduleNoDays = se debe seleccionar al menos un día para una programación semanal
err.config.scheduleDayInvalid = día no válido: "{value}"
err.config.scheduleInterval = el intervalo de la programación por horas debe ser de 1 a 23 horas
err.config.scheduleFrequencyInvalid = frecuencia de programación no válida: "{value}"
err.config.runAsInvalid = cuenta de ejecución no válida: "{value}"
err.config.templateEmpty = la plantilla de nombre de archivo no puede estar vacía
err.config.templateNoDb = la plantilla de nombre de archivo debe contener {db}
err.config.templateInvalidChars = la plantilla de nombre de archivo no puede contener \\ / : * ? " < > |
err.config.mkdir = no se pudo crear la carpeta {path}: {err}
err.config.dirPermission = no se pudieron establecer los permisos de la carpeta {path}: {err}
err.config.jobRead = no se pudo leer el archivo del trabajo: {err}
err.config.jobParse = no se pudo analizar el archivo del trabajo ({path}): {err}
err.config.jobVersion = el archivo del trabajo pertenece a una versión más reciente (v{version}); actualice el programa
err.config.settingsRead = no se pudo leer el archivo de configuración: {err}
err.config.settingsParse = no se pudo analizar el archivo de configuración ({path}): {err}
err.config.encrypt = no se pudo cifrar la contraseña: {err}
err.config.decryptBase64 = el valor cifrado no es válido (no es base64)
err.config.decrypt = no se pudo descifrar la contraseña (¿se creó en otro equipo?): {err}

# ---------- SQL Server (mssql) ----------
err.mssql.connect = no se pudo conectar al servidor: {err}
err.mssql.login = SQL Server rechazó el inicio de sesión: {err}. Compruebe el nombre de usuario y la contraseña (la autenticación de SQL también requiere el modo "Autenticación de SQL Server y Windows" en el servidor). Con la autenticación de Windows, la cuenta que ejecuta el trabajo (SYSTEM para las tareas programadas) necesita un inicio de sesión en el servidor.
err.mssql.connInvalid = configuración de conexión no válida: {err}
err.mssql.serverInfo = no se pudo leer la información del servidor: {err}
err.mssql.listDatabases = no se pudieron enumerar las bases de datos: {err}
err.mssql.backup = no se pudo hacer la copia de seguridad de {db}: {err}
err.mssql.backupHint = no se pudo hacer la copia de seguridad de {db}: {err} — Sugerencia: {hint}
err.mssql.hintAccess = La cuenta de servicio de SQL Server (normalmente {account}) no puede escribir en esta carpeta; conceda a esa cuenta el permiso Modificar sobre la carpeta o elija una carpeta en la que pueda escribir.
err.mssql.hintPath = No se encontró la carpeta en el equipo que ejecuta SQL Server. La carpeta de copia de seguridad la resuelve el servidor (en un servidor remoto no es una ruta de este equipo); cree la carpeta o use una ruta o un recurso compartido UNC accesible para el servidor.
err.mssql.hintDiskFull = No hay suficiente espacio libre en el disco de destino; libere espacio o revise la configuración de retención.
err.mssql.verify = no se pudo verificar la copia de seguridad ({file}): {err}
err.mssql.backupSet = no se pudo leer la información de la copia de seguridad ({db}): {err}
err.mssql.canceled = operación cancelada o tiempo de espera agotado: {err}
warn.mssql.insecureLogin = la contraseña de SQL Server se envía al servidor remoto sin verificar su certificado; alguien en la red podría interceptarla. Active el cifrado con verificación de certificado ("Confiar en el certificado del servidor" desactivado) o use la autenticación de Windows.

# ---------- Plantilla de nombre de archivo ----------
err.template.unmatchedClose = la plantilla de nombre de archivo tiene un '}' sin pareja
err.template.unclosed = la plantilla de nombre de archivo tiene un '{' sin cerrar
err.template.unknown = marcador desconocido en la plantilla de nombre de archivo: {{name}}

# ---------- Ejecución de la copia de seguridad ----------
err.backup.invalidJob = configuración del trabajo no válida: {err}
err.backup.alreadyRunning = el trabajo "{job}" ya se está ejecutando; esta ejecución no se inició
err.backup.lockHeld = el trabajo ya se está ejecutando
err.backup.lock = no se pudo obtener el bloqueo del trabajo: {err}
err.backup.password = no se pudo descifrar la contraseña guardada; si el archivo del trabajo se copió de otro equipo, vuelva a introducir la contraseña: {err}
err.backup.noDatabases = no hay bases de datos para copiar
err.backup.canceled = operación cancelada
err.backup.deleteBak = zip creado, pero no se pudo eliminar el .bak: {err}
err.backup.access = no se puede acceder a la carpeta de copia de seguridad: {msg}. Tanto la cuenta de servicio de SQL Server como la cuenta que ejecuta este programa ({account}) deben poder leer, escribir y eliminar en la carpeta (p. ej. D:\\SqlBackups); en un servidor remoto la ruta de acceso debe ser una ruta UNC
warn.backup.noCompression = la edición del servidor ({edition}) no admite la compresión de copias de seguridad; compresión desactivada

reason.notFound = no se encontró en el servidor
reason.systemExcluded = las bases de datos del sistema están excluidas
reason.tempdb = no se puede hacer copia de seguridad de tempdb
reason.state = la base de datos no está en un estado que permita la copia de seguridad ({state})

# ---------- Retención ----------
err.retention.readDir = no se pudo leer la carpeta de copia de seguridad: {err}
err.retention.delete = no se pudieron eliminar algunas copias de seguridad antiguas: {err}
warn.retention.noDate = no se aplicó la retención porque la plantilla de nombre de archivo no contiene fecha (año, mes y día)
warn.retention.canceled = operación cancelada; no se aplicó la retención

# ---------- ZIP (archive) ----------
err.archive.dirNotFound = no se encontró la carpeta: {path}
err.archive.dirNoPermission = sin permiso para acceder a la carpeta: {path}
err.archive.dirAccess = no se puede acceder a la carpeta: {err}
err.archive.notDir = la ruta no es una carpeta: {path}
err.archive.noWrite = sin permiso de escritura en la carpeta ({path}): {err}
err.archive.write = no se puede escribir en la carpeta ({path}): {err}
err.archive.noRead = sin permiso de lectura en la carpeta ({path}): {err}
err.archive.noDelete = sin permiso de eliminación en la carpeta ({path}): {err}
err.archive.noFiles = no hay archivos para comprimir
err.archive.readBak = no se pudo leer el archivo de copia de seguridad: {err}
err.archive.duplicateName = un zip no puede contener dos archivos con el mismo nombre: {name}
err.archive.rename = no se pudo cambiar el nombre del archivo zip: {err}
err.archive.create = no se pudo crear el archivo zip: {err}
err.archive.writeZip = no se pudo escribir el archivo zip: {err}
err.archive.entry = no se pudo crear la entrada del zip: {err}
err.archive.canceled = zip cancelado: {err}
err.archive.compress = no se pudo comprimir {name}: {err}
err.archive.verify = error en la verificación del zip: {err}
err.archive.verifyEntry = error en la verificación del zip ({name}): {err}
err.archive.verifyCount = error en la verificación del zip: se esperaban {want} entradas y se encontraron {got}
err.archive.verifyUnexpected = error en la verificación del zip: entrada inesperada {name}
err.archive.verifySize = error en la verificación del zip: el tamaño no coincide en {name} ({got} / {want})
err.archive.verifyReadSize = error en la verificación del zip: el tamaño leído no coincide en {name}

# ---------- Registro ----------
err.logging.mkdir = no se pudo crear la carpeta de registros: {err}
err.logging.open = no se pudo abrir el archivo de registro: {err}
err.logging.runsMkdir = no se pudo crear la carpeta de informes de ejecución: {err}
err.logging.runWrite = no se pudo escribir el informe de ejecución: {err}
err.logging.runRead = no se pudo leer el informe de ejecución: {err}
err.logging.runParse = no se pudo analizar el informe de ejecución ({path}): {err}
err.logging.cleanup = no se pudieron eliminar algunos archivos de registro antiguos: {err}

# ---------- Archivo por lotes y tarea programada (scheduler) ----------
err.scheduler.exePath = no se pudo determinar la ruta del programa: {err}
err.scheduler.path = ruta no válida {path}: {err}
err.scheduler.badPath = la ruta no se puede usar en una línea de comandos: "{path}"
err.scheduler.percentPath = la ruta contiene caracteres "%", que el Programador de tareas expande como variables de entorno: {path}
err.scheduler.batchWrite = no se pudo escribir el archivo por lotes {path}: {err}
err.scheduler.noUser = no se pudo determinar la cuenta de usuario de la tarea
err.scheduler.accessDenied = el Programador de tareas denegó el acceso (se requieren derechos de administrador)
err.scheduler.notFound = no se encontró la tarea programada
err.scheduler.connect = no se pudo conectar al Programador de tareas: {err}
err.scheduler.create = no se pudo crear la tarea programada: {err}
err.scheduler.delete = no se pudo eliminar la tarea programada: {err}
err.scheduler.run = no se pudo iniciar la tarea programada: {err}
err.scheduler.query = no se pudo leer la tarea programada: {err}
err.scheduler.elevate = no se pudo iniciar con derechos de administrador: {err}
err.scheduler.elevateCancelled = no se concedieron los derechos de administrador (solicitud de UAC cancelada)
err.scheduler.exeCheck = no se pudieron comprobar los permisos de {path}: {err}
err.scheduler.unsafeExe = una tarea de SYSTEM no puede ejecutar {exe}: {account} puede modificar {path} y, por tanto, ejecutar su propio código como SYSTEM. Instale el programa con el instalador (Program Files) o use una carpeta en la que solo puedan escribir los administradores.
warn.scheduler.systemWindowsAuth = la tarea se ejecuta como SYSTEM con autenticación de Windows: SQL Server necesita un inicio de sesión para NT AUTHORITY\\SYSTEM (DOMINIO\\EQUIPO$ en un servidor remoto) con permiso de copia de seguridad
warn.scheduler.systemNetworkPath = la tarea se ejecuta como SYSTEM: a la carpeta de red {path} se accede con la cuenta del equipo (DOMINIO\\EQUIPO$), que necesita permisos de lectura, escritura y eliminación
warn.scheduler.currentUser = la tarea solo se ejecuta mientras {user} tenga la sesión iniciada

# ---------- Backend de la interfaz (app) ----------
err.app.jobNotFound = no se encontró el trabajo: {job}
err.app.jobExists = ya existe un trabajo llamado "{job}"
err.app.alreadyRunning = el trabajo "{job}" ya se está ejecutando
err.app.renameRunning = el trabajo "{job}" se está ejecutando; no se puede cambiar el nombre ahora
err.app.deleteRunning = el trabajo "{job}" se está ejecutando; no se puede eliminar ahora
err.app.elevatedExit = el comando ejecutado con derechos de administrador falló (código de salida {code})
err.app.pathOutside = el archivo no está en la carpeta de registros: {path}
err.app.keepDays = la retención de registros no puede ser negativa
err.app.theme = tema desconocido: {theme}
warn.app.renamedTask = la tarea programada del nombre anterior ({path}) sigue ejecutando el trabajo anterior y fallará; elimínela y vuelva a crear la tarea
warn.app.renamedBatch = el archivo por lotes del nombre anterior ({path}) sigue ejecutando el trabajo anterior
warn.app.taskOutdated = la tarea programada ({path}) no coincide con la configuración guardada; actualice la tarea

# ---------- Mensajes de registro ----------
log.job.started = trabajo iniciado
log.job.done = trabajo finalizado
log.job.failed = no se pudo ejecutar el trabajo
log.job.alreadyRunning = el trabajo ya se está ejecutando; ejecución no iniciada
log.access.failed = no se puede acceder a la carpeta de copia de seguridad; se omitirán el zip y la retención
log.connected = conectado al servidor
log.targets = bases de datos de destino determinadas
log.db.cannotBackup = no se puede hacer copia de seguridad de la base de datos
log.db.skipped = base de datos omitida
log.backup.started = copia de seguridad iniciada
log.backup.done = copia de seguridad finalizada
log.backup.failed = error en la copia de seguridad
log.backup.sizeUnknown = no se pudo leer el tamaño de la copia de seguridad
log.zip.started = zip iniciado
log.zip.done = zip finalizado
log.zip.failed = error en el zip
log.retention.done = retención aplicada
log.retention.failed = no se pudo aplicar la retención
log.retention.noSuccess = no se aplicó la retención porque ninguna copia de seguridad se completó correctamente
log.retention.deleted = copia de seguridad antigua eliminada
log.cli.started = iniciado desde la línea de comandos
log.gui.started = iniciado desde la interfaz de usuario
warn.run.noLogFile = {err}; no se escribirá nada en el archivo de registro
log.run.saved = informe de ejecución escrito
log.run.saveFailed = no se pudo escribir el informe de ejecución
log.cleanup.done = registros antiguos limpiados
log.cleanup.failed = no se pudieron limpiar los registros antiguos
log.i18n.missing = faltan claves en los archivos de idioma

# ---------- Resumen de la ejecución ----------
summary.header = Trabajo: {job}  Servidor: {server}  Duración: {elapsed}
summary.error = ERROR: {msg}
summary.warning = ADVERTENCIA: {msg}
summary.dbOK = [OK]   {db}  {size}  {elapsed}
summary.dbFailed = [ERROR] {db}  {msg}
summary.dbSkipped = [OMITIDA] {db}  {msg}
summary.verified = verificada
summary.zipOK = [ZIP]  {file}  {source} → {size}  {elapsed}
summary.zipFailed = [ERROR ZIP] {file}  {msg}
summary.bakDeleted = .bak eliminado
summary.deleted = [ELIM]  {file}  {size}
summary.retentionFailed = [ERROR RETENCIÓN] {msg}
summary.result = Resultado: {ok} correctas, {failed} con error, {skipped} omitidas
summary.zipErrors = {count} error(es) de zip
summary.retentionError = error de retención
summary.exitCode = (código de salida {code})

# ---------- Línea de comandos ----------
cli.usage = SqlBackup {version} – copia de seguridad automática de MSSQL\n\nUso:\n  SqlBackup.exe                            abre la interfaz de usuario\n  SqlBackup.exe run   --job <trabajo> [-v] ejecuta el trabajo (copia, verificación, zip, retención)\n  SqlBackup.exe test  --job <trabajo>      prueba la conexión y el acceso a la carpeta de copia de seguridad\n  SqlBackup.exe list  --job <trabajo> [--json] enumera las bases de datos del servidor\n  SqlBackup.exe batch --job <trabajo> [--path <archivo.bat>]\n                                           escribe un archivo por lotes que ejecuta el trabajo (predeterminado: jobs\\<trabajo>.bat)\n  SqlBackup.exe task create|delete|run|status --job <trabajo> [--elevate] [--json]\n                                           administra la tarea programada (\\SqlBackup\\<trabajo>)\n  SqlBackup.exe version                    muestra la versión\n\n<trabajo>: nombre del trabajo (buscado en {jobsDir}) o ruta a un archivo .json\n  -v              escribe también las entradas del registro en la consola\n  --json          escribe la salida en formato JSON\n  --elevate       solicita derechos de administrador (UAC) cuando sea necesario\n  --lang <código> idioma (p. ej. en, tr, es); predeterminado: el idioma de la configuración o, si no, el de Windows\n  --home <carpeta> carpeta de datos (predeterminada %ProgramData%\\SqlBackup)\n  --output <archivo> escribe toda la salida en un archivo\n\nCódigos de salida: 0 correcto, 1 error parcial (task status: tarea no encontrada), 2 error/error de configuración, 3 el trabajo ya se está ejecutando
cli.error = ERROR: {msg}
cli.warning = ADVERTENCIA: {msg}
cli.yes = sí
cli.no = no
cli.err.unknownCommand = comando desconocido: {cmd}
cli.err.unexpectedArg = argumento inesperado: {arg}
cli.err.noJob = no se especificó --job
cli.err.jobNotFound = no se encontró el archivo del trabajo: {path}
cli.err.connect = no se pudo conectar: {err}
cli.warn.language = no se pudo cargar el idioma ({code}): {err}
cli.phase.backup = copia
cli.phase.verify = verificación
cli.phase.zip = zip
cli.test.server = Servidor
cli.test.version = Versión
cli.test.edition = Edición
cli.test.protocol = Protocolo
cli.test.login = Inicio de sesión
cli.test.loginValue = {login} (sysadmin: {sysadmin})
cli.test.compression = Compresión
cli.test.compressionYes = admitida
cli.test.compressionNo = no admitida
cli.test.defaultBackupDir = Carpeta de copia de seguridad predeterminada
cli.test.access = Acceso a la carpeta de copia de seguridad
cli.test.accessOK = OK ({path})
cli.test.accessFailed = ERROR
cli.test.success = Conexión correcta.
cli.list.header = BASE DE DATOS\tESTADO\tRECUPERACIÓN\tTAMAÑO (MB)\tSISTEMA\tÚLTIMA COMPLETA\tCOPIA
cli.list.failed = ERROR: {reason}
cli.list.skipped = no ({reason})
cli.list.footer = {count} base(s) de datos, se copiarán {backup}

cli.warn.jobInvalid = el trabajo tiene una configuración no válida y fallará al ejecutarse: {err}
cli.batch.saved = Archivo por lotes guardado: {path}
cli.err.noTaskCommand = no se especificó el comando de la tarea (create, delete, run, status)
cli.err.unknownTaskCommand = comando de tarea desconocido: {cmd} (create, delete, run, status)
cli.err.needAdmin = {err}; ejecútelo desde un símbolo del sistema de administrador o agregue --elevate
cli.warn.taskExeMismatch = la tarea ejecuta otro archivo de programa: {exe}
