# Fichier de langue SqlBackup – Français
# Format : clé = valeur  (UTF-8). Les lignes commençant par "#" sont des commentaires.
# Les espaces réservés comme {name} sont remplis à l'exécution ; ne les modifiez pas lors de la traduction.
# Échappements : \n nouvelle ligne, \t tabulation, \\ barre oblique inverse.
@code = fr
@name = Français

# ---------- Commun ----------
common.unknown = inconnu
common.taskDescription = Exécute la tâche SqlBackup "{job}" (créée par SqlBackup).
common.batchFiles = Fichiers batch

# ---------- Paramètres de la tâche (config) ----------
err.config.nameInvalid = le nom de la tâche doit comporter 1 à 64 caractères et ne peut contenir que des lettres, des chiffres, '_', '-' et '.'
err.config.nameDots = le nom de la tâche ne peut pas être composé uniquement de points
err.config.serverEmpty = le nom du serveur ne peut pas être vide
err.config.portRange = le port doit être compris entre 0 et 65535
err.config.portTCPOnly = un port ne peut être utilisé qu'avec le protocole TCP
err.config.protocolInvalid = protocole non valide : "{value}"
err.config.userEmpty = le nom d'utilisateur est obligatoire pour l'authentification SQL
err.config.passwordEmpty = le mot de passe est obligatoire pour l'authentification SQL
err.config.authInvalid = type d'authentification non valide : "{value}"
err.config.timeoutNegative = le délai de connexion ne peut pas être négatif
err.config.noDatabase = au moins une base de données doit être sélectionnée
err.config.serverPathEmpty = le dossier de sauvegarde (chemin serveur) ne peut pas être vide
err.config.commandTimeoutNegative = le délai d'exécution des commandes ne peut pas être négatif
err.config.deleteBakNeedsZip = la suppression des .bak après le zip nécessite que l'option zip soit activée
err.config.retentionValue = la valeur de rétention doit être supérieure à 0
err.config.retentionModeInvalid = mode de rétention non valide : "{value}"
err.config.scheduleTime = l'heure de planification doit être au format HH:MM (par ex. 02:00)
err.config.scheduleNoDays = au moins un jour doit être sélectionné pour une planification hebdomadaire
err.config.scheduleDayInvalid = jour non valide : "{value}"
err.config.scheduleInterval = l'intervalle de la planification horaire doit être de 1 à 23 heures
err.config.scheduleFrequencyInvalid = fréquence de planification non valide : "{value}"
err.config.runAsInvalid = compte d'exécution non valide : "{value}"
err.config.templateEmpty = le modèle de nom de fichier ne peut pas être vide
err.config.templateNoDb = le modèle de nom de fichier doit contenir {db}
err.config.templateInvalidChars = le modèle de nom de fichier ne peut pas contenir \\ / : * ? " < > |
err.config.mkdir = impossible de créer le dossier {path} : {err}
err.config.dirPermission = impossible de définir les autorisations du dossier {path} : {err}
err.config.jobRead = impossible de lire le fichier de tâche : {err}
err.config.jobParse = impossible d'analyser le fichier de tâche ({path}) : {err}
err.config.jobVersion = le fichier de tâche provient d'une version plus récente (v{version}) ; veuillez mettre à jour le programme
err.config.settingsRead = impossible de lire le fichier de paramètres : {err}
err.config.settingsParse = impossible d'analyser le fichier de paramètres ({path}) : {err}
err.config.encrypt = impossible de chiffrer le mot de passe : {err}
err.config.decryptBase64 = la valeur chiffrée n'est pas valide (pas du base64)
err.config.decrypt = impossible de déchiffrer le mot de passe (a-t-il été créé sur un autre ordinateur ?) : {err}

# ---------- SQL Server (mssql) ----------
err.mssql.connect = impossible de se connecter au serveur : {err}
err.mssql.login = SQL Server a refusé la connexion : {err}. Vérifiez le nom d'utilisateur et le mot de passe (l'authentification SQL nécessite aussi le mode "Authentification SQL Server et Windows" sur le serveur). Avec l'authentification Windows, le compte qui exécute la tâche (SYSTEM pour les tâches planifiées) doit disposer d'une connexion sur le serveur.
err.mssql.connInvalid = paramètres de connexion non valides : {err}
err.mssql.serverInfo = impossible de lire les informations du serveur : {err}
err.mssql.listDatabases = impossible de lister les bases de données : {err}
err.mssql.backup = impossible de sauvegarder {db} : {err}
err.mssql.backupHint = impossible de sauvegarder {db} : {err} — Conseil : {hint}
err.mssql.hintAccess = Le compte de service SQL Server (généralement {account}) ne peut pas écrire dans ce dossier ; accordez à ce compte l'autorisation Modification sur le dossier ou choisissez un dossier dans lequel il peut écrire.
err.mssql.hintPath = Le dossier est introuvable sur l'ordinateur qui exécute SQL Server. Le dossier de sauvegarde est résolu par le serveur (pour un serveur distant, ce n'est pas un chemin de cet ordinateur) ; créez le dossier ou utilisez un chemin ou un partage UNC accessible au serveur.
err.mssql.hintDiskFull = L'espace libre sur le disque cible est insuffisant ; libérez de l'espace ou vérifiez les paramètres de rétention.
err.mssql.verify = impossible de vérifier la sauvegarde ({file}) : {err}
err.mssql.backupSet = impossible de lire les informations de sauvegarde ({db}) : {err}
err.mssql.canceled = opération annulée ou délai dépassé : {err}
warn.mssql.insecureLogin = le mot de passe SQL Server est envoyé au serveur distant sans vérification de son certificat ; quelqu'un sur le réseau pourrait l'intercepter. Activez le chiffrement avec vérification du certificat ("Faire confiance au certificat du serveur" désactivé) ou utilisez l'authentification Windows.

# ---------- Modèle de nom de fichier ----------
err.template.unmatchedClose = le modèle de nom de fichier contient un '}' sans correspondance
err.template.unclosed = le modèle de nom de fichier contient un '{' non fermé
err.template.unknown = espace réservé inconnu dans le modèle de nom de fichier : {{name}}

# ---------- Exécution de la sauvegarde ----------
err.backup.invalidJob = paramètres de tâche non valides : {err}
err.backup.alreadyRunning = la tâche "{job}" est déjà en cours d'exécution ; cette exécution n'a pas été lancée
err.backup.lockHeld = la tâche est déjà en cours d'exécution
err.backup.lock = impossible d'obtenir le verrou de la tâche : {err}
err.backup.password = impossible de déchiffrer le mot de passe enregistré ; si le fichier de tâche a été copié depuis un autre ordinateur, saisissez à nouveau le mot de passe : {err}
err.backup.noDatabases = aucune base de données à sauvegarder
err.backup.canceled = opération annulée
err.backup.deleteBak = zip créé, mais le .bak n'a pas pu être supprimé : {err}
err.backup.access = impossible d'accéder au dossier de sauvegarde : {msg}. Le dossier doit être accessible en lecture, écriture et suppression à la fois par le compte de service SQL Server et par le compte qui exécute ce programme ({account}) (par ex. D:\\SqlBackups) ; pour un serveur distant, le chemin d'accès doit être un chemin UNC
warn.backup.noCompression = l'édition du serveur ({edition}) ne prend pas en charge la compression des sauvegardes ; compression désactivée

reason.notFound = introuvable sur le serveur
reason.systemExcluded = les bases de données système sont exclues
reason.tempdb = tempdb ne peut pas être sauvegardée
reason.state = la base de données n'est pas dans un état permettant la sauvegarde ({state})

# ---------- Rétention ----------
err.retention.readDir = impossible de lire le dossier de sauvegarde : {err}
err.retention.delete = certaines anciennes sauvegardes n'ont pas pu être supprimées : {err}
warn.retention.noDate = rétention non appliquée car le modèle de nom de fichier ne contient pas de date (année, mois et jour)
warn.retention.canceled = opération annulée ; rétention non appliquée

# ---------- ZIP (archive) ----------
err.archive.dirNotFound = dossier introuvable : {path}
err.archive.dirNoPermission = aucune autorisation d'accès au dossier : {path}
err.archive.dirAccess = impossible d'accéder au dossier : {err}
err.archive.notDir = le chemin n'est pas un dossier : {path}
err.archive.noWrite = aucune autorisation d'écriture sur le dossier ({path}) : {err}
err.archive.write = impossible d'écrire dans le dossier ({path}) : {err}
err.archive.noRead = aucune autorisation de lecture sur le dossier ({path}) : {err}
err.archive.noDelete = aucune autorisation de suppression sur le dossier ({path}) : {err}
err.archive.noFiles = aucun fichier à compresser
err.archive.readBak = impossible de lire le fichier de sauvegarde : {err}
err.archive.duplicateName = un zip ne peut pas contenir deux fichiers portant le même nom : {name}
err.archive.rename = impossible de renommer le fichier zip : {err}
err.archive.create = impossible de créer le fichier zip : {err}
err.archive.writeZip = impossible d'écrire le fichier zip : {err}
err.archive.entry = impossible de créer l'entrée zip : {err}
err.archive.canceled = zip annulé : {err}
err.archive.compress = impossible de compresser {name} : {err}
err.archive.verify = échec de la vérification du zip : {err}
err.archive.verifyEntry = échec de la vérification du zip ({name}) : {err}
err.archive.verifyCount = échec de la vérification du zip : {want} entrées attendues, {got} trouvées
err.archive.verifyUnexpected = échec de la vérification du zip : entrée inattendue {name}
err.archive.verifySize = échec de la vérification du zip : taille différente pour {name} ({got} / {want})
err.archive.verifyReadSize = échec de la vérification du zip : taille lue différente pour {name}

# ---------- Journalisation ----------
err.logging.mkdir = impossible de créer le dossier des journaux : {err}
err.logging.open = impossible d'ouvrir le fichier journal : {err}
err.logging.runsMkdir = impossible de créer le dossier des rapports d'exécution : {err}
err.logging.runWrite = impossible d'écrire le rapport d'exécution : {err}
err.logging.runRead = impossible de lire le rapport d'exécution : {err}
err.logging.runParse = impossible d'analyser le rapport d'exécution ({path}) : {err}
err.logging.cleanup = certains anciens fichiers journaux n'ont pas pu être supprimés : {err}

# ---------- Fichier batch et tâche planifiée (scheduler) ----------
err.scheduler.exePath = impossible de déterminer le chemin du programme : {err}
err.scheduler.path = chemin non valide {path} : {err}
err.scheduler.badPath = le chemin ne peut pas être utilisé dans une ligne de commande : "{path}"
err.scheduler.percentPath = le chemin contient des caractères "%", que le Planificateur de tâches développe comme variables d'environnement : {path}
err.scheduler.batchWrite = impossible d'écrire le fichier batch {path} : {err}
err.scheduler.noUser = impossible de déterminer le compte utilisateur de la tâche
err.scheduler.accessDenied = le Planificateur de tâches a refusé l'accès (droits d'administrateur requis)
err.scheduler.notFound = tâche planifiée introuvable
err.scheduler.connect = impossible de se connecter au Planificateur de tâches : {err}
err.scheduler.create = impossible de créer la tâche planifiée : {err}
err.scheduler.delete = impossible de supprimer la tâche planifiée : {err}
err.scheduler.run = impossible de démarrer la tâche planifiée : {err}
err.scheduler.query = impossible de lire la tâche planifiée : {err}
err.scheduler.elevate = impossible de démarrer avec les droits d'administrateur : {err}
err.scheduler.elevateCancelled = les droits d'administrateur n'ont pas été accordés (invite UAC annulée)
err.scheduler.exeCheck = impossible de vérifier les autorisations de {path} : {err}
err.scheduler.unsafeExe = une tâche SYSTEM ne peut pas exécuter {exe} : {account} peut modifier {path} et pourrait donc exécuter son propre code en tant que SYSTEM. Installez le programme avec le programme d'installation (Program Files) ou utilisez un dossier dans lequel seuls les administrateurs peuvent écrire.
warn.scheduler.systemWindowsAuth = la tâche s'exécute en tant que SYSTEM avec l'authentification Windows : SQL Server a besoin d'une connexion pour NT AUTHORITY\\SYSTEM (DOMAINE\\ORDINATEUR$ pour un serveur distant) avec l'autorisation de sauvegarde
warn.scheduler.systemNetworkPath = la tâche s'exécute en tant que SYSTEM : le dossier réseau {path} est accessible avec le compte d'ordinateur (DOMAINE\\ORDINATEUR$), qui a besoin des autorisations de lecture, d'écriture et de suppression
warn.scheduler.currentUser = la tâche ne s'exécute que lorsque {user} est connecté

# ---------- Backend de l'interface (app) ----------
err.app.jobNotFound = tâche introuvable : {job}
err.app.jobExists = une tâche nommée "{job}" existe déjà
err.app.alreadyRunning = la tâche "{job}" est déjà en cours d'exécution
err.app.renameRunning = la tâche "{job}" est en cours d'exécution ; elle ne peut pas être renommée maintenant
err.app.deleteRunning = la tâche "{job}" est en cours d'exécution ; elle ne peut pas être supprimée maintenant
err.app.elevatedExit = la commande exécutée avec les droits d'administrateur a échoué (code de sortie {code})
err.app.pathOutside = le fichier ne se trouve pas dans le dossier des journaux : {path}
err.app.keepDays = la durée de conservation des journaux ne peut pas être négative
err.app.theme = thème inconnu : {theme}
warn.app.renamedTask = la tâche planifiée de l'ancien nom ({path}) exécute toujours l'ancienne tâche et échouera ; supprimez-la et créez à nouveau la tâche planifiée
warn.app.renamedBatch = le fichier batch de l'ancien nom ({path}) exécute toujours l'ancienne tâche
warn.app.taskOutdated = la tâche planifiée ({path}) ne correspond pas aux paramètres enregistrés ; mettez-la à jour

# ---------- Messages du journal ----------
log.job.started = tâche démarrée
log.job.done = tâche terminée
log.job.failed = la tâche n'a pas pu s'exécuter
log.job.alreadyRunning = la tâche est déjà en cours d'exécution ; exécution non lancée
log.access.failed = impossible d'accéder au dossier de sauvegarde ; le zip et la rétention seront ignorés
log.connected = connecté au serveur
log.targets = bases de données cibles déterminées
log.db.cannotBackup = la base de données ne peut pas être sauvegardée
log.db.skipped = base de données ignorée
log.backup.started = sauvegarde démarrée
log.backup.done = sauvegarde terminée
log.backup.failed = échec de la sauvegarde
log.backup.sizeUnknown = impossible de lire la taille de la sauvegarde
log.zip.started = zip démarré
log.zip.done = zip terminé
log.zip.failed = échec du zip
log.retention.done = rétention appliquée
log.retention.failed = la rétention n'a pas pu être appliquée
log.retention.noSuccess = rétention non appliquée car aucune sauvegarde n'a réussi
log.retention.deleted = ancienne sauvegarde supprimée
log.cli.started = démarré depuis la ligne de commande
log.gui.started = démarré depuis l'interface utilisateur
warn.run.noLogFile = {err} ; rien ne sera écrit dans le fichier journal
log.run.saved = rapport d'exécution écrit
log.run.saveFailed = impossible d'écrire le rapport d'exécution
log.cleanup.done = anciens journaux nettoyés
log.cleanup.failed = impossible de nettoyer les anciens journaux
log.i18n.missing = des clés manquent dans les fichiers de langue

# ---------- Résumé de l'exécution ----------
summary.header = Tâche : {job}  Serveur : {server}  Durée : {elapsed}
summary.error = ERREUR : {msg}
summary.warning = AVERTISSEMENT : {msg}
summary.dbOK = [OK]   {db}  {size}  {elapsed}
summary.dbFailed = [ÉCHEC] {db}  {msg}
summary.dbSkipped = [IGNORÉ] {db}  {msg}
summary.verified = vérifiée
summary.zipOK = [ZIP]  {file}  {source} → {size}  {elapsed}
summary.zipFailed = [ÉCHEC ZIP] {file}  {msg}
summary.bakDeleted = .bak supprimé
summary.deleted = [SUPPR]  {file}  {size}
summary.retentionFailed = [ÉCHEC RÉTENTION] {msg}
summary.result = Résultat : {ok} réussie(s), {failed} en échec, {skipped} ignorée(s)
summary.zipErrors = {count} erreur(s) zip
summary.retentionError = erreur de rétention
summary.exitCode = (code de sortie {code})

# ---------- Ligne de commande ----------
cli.usage = SqlBackup {version} – sauvegarde MSSQL automatique\n\nUtilisation :\n  SqlBackup.exe                            ouvre l'interface utilisateur\n  SqlBackup.exe run   --job <tâche> [-v]   exécute la tâche (sauvegarde, vérification, zip, rétention)\n  SqlBackup.exe test  --job <tâche>        teste la connexion et l'accès au dossier de sauvegarde\n  SqlBackup.exe list  --job <tâche> [--json] liste les bases de données du serveur\n  SqlBackup.exe batch --job <tâche> [--path <fichier.bat>]\n                                           écrit un fichier batch qui exécute la tâche (par défaut : jobs\\<tâche>.bat)\n  SqlBackup.exe task create|delete|run|status --job <tâche> [--elevate] [--json]\n                                           gère la tâche planifiée (\\SqlBackup\\<tâche>)\n  SqlBackup.exe version                    affiche la version\n\n<tâche> : nom de la tâche (recherché dans {jobsDir}) ou chemin d'un fichier .json\n  -v              écrit aussi les entrées du journal dans la console\n  --json          écrit la sortie au format JSON\n  --elevate       demande les droits d'administrateur (UAC) si nécessaire\n  --lang <code>   langue (par ex. en, tr, fr) ; par défaut : langue des paramètres, sinon langue de Windows\n  --home <dossier> dossier de données (par défaut %ProgramData%\\SqlBackup)\n  --output <fichier> écrit toute la sortie dans un fichier\n\nCodes de sortie : 0 succès, 1 échec partiel (task status : tâche introuvable), 2 échec/erreur de paramètres, 3 tâche déjà en cours
cli.error = ERREUR : {msg}
cli.warning = AVERTISSEMENT : {msg}
cli.yes = oui
cli.no = non
cli.err.unknownCommand = commande inconnue : {cmd}
cli.err.unexpectedArg = argument inattendu : {arg}
cli.err.noJob = --job non spécifié
cli.err.jobNotFound = fichier de tâche introuvable : {path}
cli.err.connect = impossible de se connecter : {err}
cli.warn.language = impossible de charger la langue ({code}) : {err}
cli.phase.backup = sauvegarde
cli.phase.verify = vérification
cli.phase.zip = zip
cli.test.server = Serveur
cli.test.version = Version
cli.test.edition = Édition
cli.test.protocol = Protocole
cli.test.login = Connexion
cli.test.loginValue = {login} (sysadmin : {sysadmin})
cli.test.compression = Compression
cli.test.compressionYes = prise en charge
cli.test.compressionNo = non prise en charge
cli.test.defaultBackupDir = Dossier de sauvegarde par défaut
cli.test.access = Accès au dossier de sauvegarde
cli.test.accessOK = OK ({path})
cli.test.accessFailed = ERREUR
cli.test.success = Connexion réussie.
cli.list.header = BASE DE DONNÉES\tÉTAT\tRÉCUPÉRATION\tTAILLE (Mo)\tSYSTÈME\tDERNIÈRE COMPLÈTE\tSAUVEGARDE
cli.list.failed = ERREUR : {reason}
cli.list.skipped = non ({reason})
cli.list.footer = {count} base(s) de données, {backup} seront sauvegardées

cli.warn.jobInvalid = la tâche comporte des paramètres non valides et échouera à l'exécution : {err}
cli.batch.saved = Fichier batch enregistré : {path}
cli.err.noTaskCommand = commande de tâche non spécifiée (create, delete, run, status)
cli.err.unknownTaskCommand = commande de tâche inconnue : {cmd} (create, delete, run, status)
cli.err.needAdmin = {err} ; exécutez depuis une invite de commandes administrateur ou ajoutez --elevate
cli.warn.taskExeMismatch = la tâche planifiée exécute un autre fichier programme : {exe}
