# Arquivo de idioma do SqlBackup – Português
# Formato: chave = valor  (UTF-8). Linhas que começam com "#" são comentários.
# Marcadores como {name} são preenchidos em tempo de execução; mantenha-os inalterados ao traduzir.
# Escapes: \n nova linha, \t tabulação, \\ barra invertida.
@code = pt
@name = Português

# ---------- Comum ----------
common.unknown = desconhecido
common.taskDescription = Executa o trabalho do SqlBackup "{job}" (criado pelo SqlBackup).
common.batchFiles = Arquivos em lote

# ---------- Configurações do trabalho (config) ----------
err.config.nameInvalid = o nome do trabalho deve ter de 1 a 64 caracteres e só pode conter letras, dígitos, '_', '-' e '.'
err.config.nameDots = o nome do trabalho não pode ser formado apenas por pontos
err.config.serverEmpty = o nome do servidor não pode ficar vazio
err.config.portRange = a porta deve estar entre 0 e 65535
err.config.portTCPOnly = a porta só pode ser usada com o protocolo TCP
err.config.protocolInvalid = protocolo inválido: "{value}"
err.config.userEmpty = o nome de usuário é obrigatório para a autenticação do SQL
err.config.passwordEmpty = a senha é obrigatória para a autenticação do SQL
err.config.authInvalid = tipo de autenticação inválido: "{value}"
err.config.timeoutNegative = o tempo limite de conexão não pode ser negativo
err.config.noDatabase = é necessário selecionar pelo menos um banco de dados
err.config.serverPathEmpty = a pasta de backup (caminho no servidor) não pode ficar vazia
err.config.commandTimeoutNegative = o tempo limite de comando não pode ser negativo
err.config.deleteBakNeedsZip = para excluir os .bak após o zip, a opção zip precisa estar ativada
err.config.retentionValue = o valor de retenção deve ser maior que 0
err.config.retentionModeInvalid = modo de retenção inválido: "{value}"
err.config.scheduleTime = o horário do agendamento deve estar no formato HH:MM (ex.: 02:00)
err.config.scheduleNoDays = é necessário selecionar pelo menos um dia para um agendamento semanal
err.config.scheduleDayInvalid = dia inválido: "{value}"
err.config.scheduleInterval = o intervalo do agendamento por hora deve ser de 1 a 23 horas
err.config.scheduleFrequencyInvalid = frequência de agendamento inválida: "{value}"
err.config.runAsInvalid = conta de execução inválida: "{value}"
err.config.templateEmpty = o modelo de nome de arquivo não pode ficar vazio
err.config.templateNoDb = o modelo de nome de arquivo deve conter {db}
err.config.templateInvalidChars = o modelo de nome de arquivo não pode conter \\ / : * ? " < > |
err.config.mkdir = não foi possível criar a pasta {path}: {err}
err.config.dirPermission = não foi possível definir as permissões da pasta {path}: {err}
err.config.jobRead = não foi possível ler o arquivo do trabalho: {err}
err.config.jobParse = não foi possível interpretar o arquivo do trabalho ({path}): {err}
err.config.jobVersion = o arquivo do trabalho pertence a uma versão mais recente (v{version}); atualize o programa
err.config.settingsRead = não foi possível ler o arquivo de configurações: {err}
err.config.settingsParse = não foi possível interpretar o arquivo de configurações ({path}): {err}
err.config.encrypt = não foi possível criptografar a senha: {err}
err.config.decryptBase64 = o valor criptografado é inválido (não é base64)
err.config.decrypt = não foi possível descriptografar a senha (ela foi criada em outro computador?): {err}

# ---------- SQL Server (mssql) ----------
err.mssql.connect = não foi possível conectar ao servidor: {err}
err.mssql.login = O SQL Server recusou o logon: {err}. Verifique o nome de usuário e a senha (a autenticação do SQL também exige o modo "Autenticação do SQL Server e do Windows" no servidor). Com a autenticação do Windows, a conta que executa o trabalho (SYSTEM para tarefas agendadas) precisa de um logon no servidor.
err.mssql.connInvalid = configurações de conexão inválidas: {err}
err.mssql.serverInfo = não foi possível ler as informações do servidor: {err}
err.mssql.listDatabases = não foi possível listar os bancos de dados: {err}
err.mssql.backup = não foi possível fazer backup de {db}: {err}
err.mssql.backupHint = não foi possível fazer backup de {db}: {err} — Dica: {hint}
err.mssql.hintAccess = A conta de serviço do SQL Server (normalmente {account}) não consegue gravar nesta pasta; conceda a essa conta a permissão Modificar na pasta ou escolha uma pasta em que ela possa gravar.
err.mssql.hintPath = A pasta não foi encontrada no computador que executa o SQL Server. A pasta de backup é resolvida pelo servidor (em um servidor remoto não é um caminho deste computador); crie a pasta ou use um caminho ou compartilhamento UNC acessível ao servidor.
err.mssql.hintDiskFull = Não há espaço livre suficiente no disco de destino; libere espaço ou revise as configurações de retenção.
err.mssql.verify = não foi possível verificar o backup ({file}): {err}
err.mssql.backupSet = não foi possível ler as informações do backup ({db}): {err}
err.mssql.canceled = operação cancelada ou tempo limite esgotado: {err}
warn.mssql.insecureLogin = a senha do SQL Server é enviada ao servidor remoto sem verificar o certificado dele; alguém na rede poderia interceptá-la. Ative a criptografia com verificação de certificado ("Confiar no certificado do servidor" desligado) ou use a autenticação do Windows.

# ---------- Modelo de nome de arquivo ----------
err.template.unmatchedClose = o modelo de nome de arquivo tem um '}' sem par
err.template.unclosed = o modelo de nome de arquivo tem um '{' não fechado
err.template.unknown = marcador desconhecido no modelo de nome de arquivo: {{name}}

# ---------- Execução do backup ----------
err.backup.invalidJob = configurações do trabalho inválidas: {err}
err.backup.alreadyRunning = o trabalho "{job}" já está em execução; esta execução não foi iniciada
err.backup.lockHeld = o trabalho já está em execução
err.backup.lock = não foi possível obter o bloqueio do trabalho: {err}
err.backup.password = não foi possível descriptografar a senha salva; se o arquivo do trabalho foi copiado de outro computador, digite a senha novamente: {err}
err.backup.noDatabases = não há bancos de dados para fazer backup
err.backup.canceled = operação cancelada
err.backup.deleteBak = zip criado, mas não foi possível excluir o .bak: {err}
err.backup.access = não é possível acessar a pasta de backup: {msg}. A pasta deve permitir leitura, gravação e exclusão tanto para a conta de serviço do SQL Server quanto para a conta que executa este programa ({account}) (ex.: D:\\SqlBackups); em um servidor remoto o caminho de acesso deve ser um caminho UNC
warn.backup.noCompression = a edição do servidor ({edition}) não oferece suporte à compactação de backup; compactação desativada

reason.notFound = não encontrado no servidor
reason.systemExcluded = os bancos de dados do sistema estão excluídos
reason.tempdb = não é possível fazer backup do tempdb
reason.state = o banco de dados não está em um estado que permita backup ({state})

# ---------- Retenção ----------
err.retention.readDir = não foi possível ler a pasta de backup: {err}
err.retention.delete = não foi possível excluir alguns backups antigos: {err}
warn.retention.noDate = retenção não aplicada porque o modelo de nome de arquivo não contém data (ano, mês e dia)
warn.retention.canceled = operação cancelada; retenção não aplicada

# ---------- ZIP (archive) ----------
err.archive.dirNotFound = pasta não encontrada: {path}
err.archive.dirNoPermission = sem permissão para acessar a pasta: {path}
err.archive.dirAccess = não é possível acessar a pasta: {err}
err.archive.notDir = o caminho não é uma pasta: {path}
err.archive.noWrite = sem permissão de gravação na pasta ({path}): {err}
err.archive.write = não é possível gravar na pasta ({path}): {err}
err.archive.noRead = sem permissão de leitura na pasta ({path}): {err}
err.archive.noDelete = sem permissão de exclusão na pasta ({path}): {err}
err.archive.noFiles = não há arquivos para compactar
err.archive.readBak = não foi possível ler o arquivo de backup: {err}
err.archive.duplicateName = um zip não pode conter dois arquivos com o mesmo nome: {name}
err.archive.rename = não foi possível renomear o arquivo zip: {err}
err.archive.create = não foi possível criar o arquivo zip: {err}
err.archive.writeZip = não foi possível gravar o arquivo zip: {err}
err.archive.entry = não foi possível criar a entrada do zip: {err}
err.archive.canceled = zip cancelado: {err}
err.archive.compress = não foi possível compactar {name}: {err}
err.archive.verify = falha na verificação do zip: {err}
err.archive.verifyEntry = falha na verificação do zip ({name}): {err}
err.archive.verifyCount = falha na verificação do zip: esperadas {want} entradas, encontradas {got}
err.archive.verifyUnexpected = falha na verificação do zip: entrada inesperada {name}
err.archive.verifySize = falha na verificação do zip: tamanho divergente em {name} ({got} / {want})
err.archive.verifyReadSize = falha na verificação do zip: tamanho lido divergente em {name}

# ---------- Registro em log ----------
err.logging.mkdir = não foi possível criar a pasta de logs: {err}
err.logging.open = não foi possível abrir o arquivo de log: {err}
err.logging.runsMkdir = não foi possível criar a pasta de relatórios de execução: {err}
err.logging.runWrite = não foi possível gravar o relatório de execução: {err}
err.logging.runRead = não foi possível ler o relatório de execução: {err}
err.logging.runParse = não foi possível interpretar o relatório de execução ({path}): {err}
err.logging.cleanup = não foi possível excluir alguns arquivos de log antigos: {err}

# ---------- Arquivo em lote e tarefa agendada (scheduler) ----------
err.scheduler.exePath = não foi possível determinar o caminho do programa: {err}
err.scheduler.path = caminho inválido {path}: {err}
err.scheduler.badPath = o caminho não pode ser usado em uma linha de comando: "{path}"
err.scheduler.percentPath = o caminho contém caracteres "%", que o Agendador de Tarefas expande como variáveis de ambiente: {path}
err.scheduler.batchWrite = não foi possível gravar o arquivo em lote {path}: {err}
err.scheduler.noUser = não foi possível determinar a conta de usuário da tarefa
err.scheduler.accessDenied = o Agendador de Tarefas negou o acesso (são necessários direitos de administrador)
err.scheduler.notFound = tarefa agendada não encontrada
err.scheduler.connect = não foi possível conectar ao Agendador de Tarefas: {err}
err.scheduler.create = não foi possível criar a tarefa agendada: {err}
err.scheduler.delete = não foi possível excluir a tarefa agendada: {err}
err.scheduler.run = não foi possível iniciar a tarefa agendada: {err}
err.scheduler.query = não foi possível ler a tarefa agendada: {err}
err.scheduler.elevate = não foi possível iniciar com direitos de administrador: {err}
err.scheduler.elevateCancelled = os direitos de administrador não foram concedidos (solicitação do UAC cancelada)
err.scheduler.exeCheck = não foi possível verificar as permissões de {path}: {err}
err.scheduler.unsafeExe = uma tarefa SYSTEM não pode executar {exe}: {account} pode modificar {path} e, assim, executar seu próprio código como SYSTEM. Instale o programa com o instalador (Program Files) ou use uma pasta em que só administradores possam gravar.
warn.scheduler.systemWindowsAuth = a tarefa é executada como SYSTEM com autenticação do Windows: o SQL Server precisa de um logon para NT AUTHORITY\\SYSTEM (DOMINIO\\COMPUTADOR$ em um servidor remoto) com permissão de backup
warn.scheduler.systemNetworkPath = a tarefa é executada como SYSTEM: a pasta de rede {path} é acessada com a conta do computador (DOMINIO\\COMPUTADOR$), que precisa de permissão de leitura, gravação e exclusão
warn.scheduler.currentUser = a tarefa só é executada enquanto {user} estiver conectado

# ---------- Backend da interface (app) ----------
err.app.jobNotFound = trabalho não encontrado: {job}
err.app.jobExists = já existe um trabalho chamado "{job}"
err.app.alreadyRunning = o trabalho "{job}" já está em execução
err.app.renameRunning = o trabalho "{job}" está em execução; não é possível renomeá-lo agora
err.app.deleteRunning = o trabalho "{job}" está em execução; não é possível excluí-lo agora
err.app.elevatedExit = o comando executado com direitos de administrador falhou (código de saída {code})
err.app.pathOutside = o arquivo não está na pasta de logs: {path}
err.app.keepDays = a retenção de logs não pode ser negativa
err.app.theme = tema desconhecido: {theme}
warn.app.renamedTask = a tarefa agendada do nome antigo ({path}) ainda executa o trabalho antigo e vai falhar; exclua-a e crie a tarefa novamente
warn.app.renamedBatch = o arquivo em lote do nome antigo ({path}) ainda executa o trabalho antigo
warn.app.taskOutdated = a tarefa agendada ({path}) não corresponde às configurações salvas; atualize a tarefa

# ---------- Mensagens de log ----------
log.job.started = trabalho iniciado
log.job.done = trabalho concluído
log.job.failed = não foi possível executar o trabalho
log.job.alreadyRunning = o trabalho já está em execução; execução não iniciada
log.access.failed = não é possível acessar a pasta de backup; o zip e a retenção serão ignorados
log.connected = conectado ao servidor
log.targets = bancos de dados de destino determinados
log.db.cannotBackup = não é possível fazer backup do banco de dados
log.db.skipped = banco de dados ignorado
log.backup.started = backup iniciado
log.backup.done = backup concluído
log.backup.failed = falha no backup
log.backup.sizeUnknown = não foi possível ler o tamanho do backup
log.zip.started = zip iniciado
log.zip.done = zip concluído
log.zip.failed = falha no zip
log.retention.done = retenção aplicada
log.retention.failed = não foi possível aplicar a retenção
log.retention.noSuccess = retenção não aplicada porque nenhum backup foi bem-sucedido
log.retention.deleted = backup antigo excluído
log.cli.started = iniciado pela linha de comando
log.gui.started = iniciado pela interface do usuário
warn.run.noLogFile = {err}; nada será gravado no arquivo de log
log.run.saved = relatório de execução gravado
log.run.saveFailed = não foi possível gravar o relatório de execução
log.cleanup.done = logs antigos limpos
log.cleanup.failed = não foi possível limpar os logs antigos
log.i18n.missing = há chaves ausentes nos arquivos de idioma

# ---------- Resumo da execução ----------
summary.header = Trabalho: {job}  Servidor: {server}  Duração: {elapsed}
summary.error = ERRO: {msg}
summary.warning = AVISO: {msg}
summary.dbOK = [OK]   {db}  {size}  {elapsed}
summary.dbFailed = [FALHA] {db}  {msg}
summary.dbSkipped = [IGNORADO] {db}  {msg}
summary.verified = verificado
summary.zipOK = [ZIP]  {file}  {source} → {size}  {elapsed}
summary.zipFailed = [FALHA ZIP] {file}  {msg}
summary.bakDeleted = .bak excluído
summary.deleted = [EXCL]  {file}  {size}
summary.retentionFailed = [FALHA RETENÇÃO] {msg}
summary.result = Resultado: {ok} com sucesso, {failed} com falha, {skipped} ignorados
summary.zipErrors = {count} erro(s) de zip
summary.retentionError = erro de retenção
summary.exitCode = (código de saída {code})

# ---------- Linha de comando ----------
cli.usage = SqlBackup {version} – backup automático do MSSQL\n\nUso:\n  SqlBackup.exe                            abre a interface do usuário\n  SqlBackup.exe run   --job <trabalho> [-v] executa o trabalho (backup, verificação, zip, retenção)\n  SqlBackup.exe test  --job <trabalho>     testa a conexão e o acesso à pasta de backup\n  SqlBackup.exe list  --job <trabalho> [--json] lista os bancos de dados do servidor\n  SqlBackup.exe batch --job <trabalho> [--path <arquivo.bat>]\n                                           grava um arquivo em lote que executa o trabalho (padrão: jobs\\<trabalho>.bat)\n  SqlBackup.exe task create|delete|run|status --job <trabalho> [--elevate] [--json]\n                                           gerencia a tarefa agendada (\\SqlBackup\\<trabalho>)\n  SqlBackup.exe version                    mostra a versão\n\n<trabalho>: nome do trabalho (procurado em {jobsDir}) ou caminho de um arquivo .json\n  -v              também grava as entradas de log no console\n  --json          grava a saída em JSON\n  --elevate       solicita direitos de administrador (UAC) quando necessário\n  --lang <código> idioma (ex.: en, tr, pt); padrão: o idioma das configurações ou, se não houver, o do Windows\n  --home <pasta>  pasta de dados (padrão %ProgramData%\\SqlBackup)\n  --output <arquivo> grava toda a saída em um arquivo\n\nCódigos de saída: 0 sucesso, 1 falha parcial (task status: tarefa não encontrada), 2 falha/erro de configuração, 3 trabalho já em execução
cli.error = ERRO: {msg}
cli.warning = AVISO: {msg}
cli.yes = sim
cli.no = não
cli.err.unknownCommand = comando desconhecido: {cmd}
cli.err.unexpectedArg = argumento inesperado: {arg}
cli.err.noJob = --job não especificado
cli.err.jobNotFound = arquivo do trabalho não encontrado: {path}
cli.err.connect = não foi possível conectar: {err}
cli.warn.language = não foi possível carregar o idioma ({code}): {err}
cli.phase.backup = backup
cli.phase.verify = verificação
cli.phase.zip = zip
cli.test.server = Servidor
cli.test.version = Versão
cli.test.edition = Edição
cli.test.protocol = Protocolo
cli.test.login = Logon
cli.test.loginValue = {login} (sysadmin: {sysadmin})
cli.test.compression = Compactação
cli.test.compressionYes = suportada
cli.test.compressionNo = não suportada
cli.test.defaultBackupDir = Pasta de backup padrão
cli.test.access = Acesso à pasta de backup
cli.test.accessOK = OK ({path})
cli.test.accessFailed = ERRO
cli.test.success = Conexão bem-sucedida.
cli.list.header = BANCO DE DADOS\tESTADO\tRECUPERAÇÃO\tTAMANHO (MB)\tSISTEMA\tÚLTIMO COMPLETO\tBACKUP
cli.list.failed = ERRO: {reason}
cli.list.skipped = não ({reason})
cli.list.footer = {count} banco(s) de dados, {backup} terão backup

cli.warn.jobInvalid = o trabalho tem configurações inválidas e vai falhar ao ser executado: {err}
cli.batch.saved = Arquivo em lote salvo: {path}
cli.err.noTaskCommand = comando de tarefa não especificado (create, delete, run, status)
cli.err.unknownTaskCommand = comando de tarefa desconhecido: {cmd} (create, delete, run, status)
cli.err.needAdmin = {err}; execute em um prompt de comando de administrador ou adicione --elevate
cli.warn.taskExeMismatch = a tarefa executa outro arquivo de programa: {exe}
